package animation_gen

// animation_events_gen: registers every @(comp_on_animation_event) proc with
// the animation plugin (animation/events.odin).
//
// - The proc names its component with `component = T`, a @(component) type of
//   its own package, and is named comp_on_animation_event_<T>. Anything else
//   stops the build.
// - Each package with such procs gets animation_events_generated.odin: an
//   @(init) that registers each one under its type key. The package already
//   imports the animation plugin, for the event type its procs take, so no
//   import is added that it did not have.
// - An @(init), as union_gen's: this file is not on disk when the phase table
//   is scanned in the same prebuild.
//
// A package that loses its last proc keeps a stale generated file until it is
// deleted by hand: it then fails the build loudly, naming the missing proc.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

_ATTRIBUTE :: "comp_on_animation_event"
_ANIMATION_PKG :: "moonhug/packages/animation"

Animation_Event_GenComp :: struct {
	component: string, // T
}

@(init)
_register :: proc "contextless" () {
	db.provider("animation/events/provide", events_provide)
	db.generator("animation/events/generate", events_generate)
}

events_provide :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	tagged := db.get_or_create_comps(w, Animation_Event_GenComp)

	m := db.all_of(db.r(decls), db.r(procs), db.r(attrs))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		args, has := gen_facts.attr_find(db.get(attrs, entity), _ATTRIBUTE)
		if !has || decl.name == "" do continue
		where_ := fmt.tprintf("%s:%d", gen_facts.decl_rel_path(decl), decl.decl.pos.line)
		comp := args.fields["component"]
		if comp == "" do comp = gen_facts.attr_keyname(args, "component")
		if comp == "" || strings.contains(comp, ".") {
			fmt.eprintf("animation_events_gen: %s: @(%s) names its component with component=T, a type of the same package\n", where_, _ATTRIBUTE)
			return false
		}
		if want := gen_facts.comp_proc_name(_ATTRIBUTE, comp); decl.name != want {
			fmt.eprintf("animation_events_gen: %s: a @(%s={{component=%s}}) proc is named %s\n", where_, _ATTRIBUTE, comp, want)
			return false
		}
		db.set(tagged, entity, Animation_Event_GenComp{component = comp})
	}
	return true
}

@(private = "file")
_Row :: struct {
	pkg_path:  string,
	pkg_name:  string,
	component: string,
	proc_name: string,
}

events_generate :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	tagged := db.get_comps(w, Animation_Event_GenComp)
	if tagged == nil do return true

	// Every @(component), by "<package path>/<T>".
	components := make(map[string]bool, context.temp_allocator)
	{
		comps := db.get_comps(w, gen_facts.Component_GenComp)
		m := db.all_of(db.r(decls), db.r(comps))
		defer db.matcher_destroy(&m)
		for entity in db.matched(w, &m) {
			c := db.get(comps, entity)
			if c.kind != .Component do continue
			components[fmt.tprintf("%s/%s", db.get(decls, entity).pkg_path, db.get(decls, entity).name)] = true
		}
	}

	rows := make([dynamic]_Row, context.temp_allocator)
	m := db.all_of(db.r(decls), db.r(tagged))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		comp := db.get(tagged, entity).component
		if !components[fmt.tprintf("%s/%s", decl.pkg_path, comp)] {
			fmt.eprintf("animation_events_gen: %s:%d: %s is not a @(component) of package %s\n", gen_facts.decl_rel_path(decl), decl.decl.pos.line, comp, decl.pkg.name)
			return false
		}
		append(&rows, _Row{pkg_path = decl.pkg_path, pkg_name = decl.pkg.name, component = comp, proc_name = decl.name})
	}
	slice.sort_by(rows[:], proc(a, b: _Row) -> bool {
		if a.pkg_path != b.pkg_path do return a.pkg_path < b.pkg_path
		return a.component < b.component
	})

	for i := 0; i < len(rows); {
		first := rows[i]
		j := i
		for j < len(rows) && rows[j].pkg_path == first.pkg_path do j += 1
		own := first.pkg_path == _ANIMATION_PKG
		qual := own ? "" : "animation."

		b := strings.builder_make(context.temp_allocator)
		fmt.sbprintf(&b, "package %s\n\n", first.pkg_name)
		strings.write_string(&b, "import \"base:runtime\"\n")
		if !own do strings.write_string(&b, "import animation \"moonhug:packages/animation\"\n")
		strings.write_string(&b, "\n// Code generated by animation_events_gen. Do not edit.\n")
		strings.write_string(&b, "// The package's @(comp_on_animation_event) procs, registered with the\n")
		strings.write_string(&b, "// animation plugin under their component's type key.\n\n")
		strings.write_string(&b, "@(init)\n")
		fmt.sbprintf(&b, "_register_%s_animation_events :: proc \"contextless\" () {{\n", first.pkg_name)
		strings.write_string(&b, "\tcontext = runtime.default_context()\n")
		for r in rows[i:j] {
			fmt.sbprintf(&b, "\t%sanimation_event_proc_register(.%s, proc(c: rawptr, ev: %sAnimation_Event) {{ %s(cast(^%s)c, ev) }})\n", qual, r.component, qual, r.proc_name, r.component)
		}
		strings.write_string(&b, "}\n")
		db.emit(w, fmt.tprintf("%s/animation_events_generated.odin", first.pkg_path), strings.to_string(b))
		i = j
	}
	return true
}
