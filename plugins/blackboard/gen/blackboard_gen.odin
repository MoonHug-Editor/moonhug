package blackboard_gen

// blackboard_gen: emits Blackboard_Value, the union of every type a
// Blackboard entry can hold, and `value_types`, the list the inspector shows.
//
// - The built-in types are literal types (f32, [3]f32) and two core structs,
//   listed here. A literal type is saved by its text, so it needs no guid.
// - Any other is a type with @(blackboard_value) and @(typ_guid), declared
//   in an integration subpackage named after this plugin
//   (`<plugin>/blackboard`). The union imports its package, which prebuild
//   scans only while both plugins are installed.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

@(private = "file")
_ROOT :: "moonhug/packages/blackboard"

// The built-in value types, in the order the inspector lists them. The first
// is what a new entry holds.
@(private = "file")
_BUILT_IN := [?]struct{ type, name: string }{
	{"f32", "Number"},
	{"i32", "Integer"},
	{"bool", "Flag"},
	{"[2]f32", "Vector2"},
	{"[3]f32", "Vector3"},
	{"[4]f32", "Color"},
	{"core.Ref", "Object"},
	{"core.PPtr", "Asset"},
}

Blackboard_Value_GenComp :: struct {
	name: string, // what the inspector lists it by
}

@(init)
_register :: proc "contextless" () {
	db.provider("blackboard/value/provide", value_provide)
	db.generator("blackboard/value/generate", value_generate)
}

value_provide :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	values := db.get_or_create_comps(w, Blackboard_Value_GenComp)

	m := db.all_of(db.r(decls), db.r(attrs))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		attr_set := db.get(attrs, entity)
		args, has := gen_facts.attr_find(attr_set, "blackboard_value")
		if !has || decl.name == "" do continue
		where_ := fmt.tprintf("%s:%d", gen_facts.decl_rel_path(decl), decl.decl.pos.line)
		if _, tagged := gen_facts.attr_find(attr_set, "typ_guid"); !tagged {
			fmt.eprintf("blackboard_gen: %s: %s has @(blackboard_value) and needs @(typ_guid), its identity in saved entries\n", where_, decl.name)
			return false
		}
		if strings.has_suffix(decl.pkg_path, "/editor") {
			fmt.eprintf("blackboard_gen: %s: %s is in an editor package, which the game does not have\n", where_, decl.name)
			return false
		}
		name := args.fields["name"]
		if name == "" do name = decl.name
		db.set(values, entity, Blackboard_Value_GenComp{name = name})
	}
	return true
}

@(private = "file")
_Row :: struct {
	type_name: string,
	pkg_name:  string,
	pkg_path:  string,
	name:      string,
}

value_generate :: proc(w: ^db.World) -> bool {
	rows := make([dynamic]_Row, context.temp_allocator)
	decls := db.get_comps_DeclInfo()
	values := db.get_comps(w, Blackboard_Value_GenComp)
	if values != nil {
		m := db.all_of(db.r(decls), db.r(values))
		defer db.matcher_destroy(&m)
		for entity in db.matched(w, &m) {
			decl := db.get(decls, entity)
			append(&rows, _Row{type_name = decl.name, pkg_name = decl.pkg.name, pkg_path = decl.pkg_path, name = db.get(values, entity).name})
		}
	}
	// After the built-in ones, by name, so the list reads the same on every build.
	slice.sort_by(rows[:], proc(a, b: _Row) -> bool {
		if a.name != b.name do return a.name < b.name
		return a.pkg_path < b.pkg_path
	})

	b := strings.builder_make(context.temp_allocator)
	strings.write_string(&b, "package blackboard\n\n")
	strings.write_string(&b, "import \"base:runtime\"\n")
	strings.write_string(&b, "import core \"moonhug:libs/core\"\n")
	strings.write_string(&b, "import serialization \"moonhug:libs/serialization\"\n")
	imported := make([dynamic]string, context.temp_allocator)
	for r in rows {
		if r.pkg_path == _ROOT || slice.contains(imported[:], r.pkg_path) do continue
		append(&imported, r.pkg_path)
		fmt.sbprintf(&b, "import %s \"moonhug:%s\"\n", r.pkg_name, r.pkg_path[len("moonhug/"):])
	}
	strings.write_string(&b, "\n// Code generated by blackboard_gen. Do not edit.\n")
	strings.write_string(&b, "// Every type a Blackboard entry can hold: the built-in ones, then each type\n")
	strings.write_string(&b, "// with @(blackboard_value) (value_type_of).\n\n")

	strings.write_string(&b, "Blackboard_Value :: union #no_nil {\n")
	for t in _BUILT_IN do fmt.sbprintf(&b, "\t%s,\n", t.type)
	for r in rows do fmt.sbprintf(&b, "\t%s,\n", _qualified(r))
	strings.write_string(&b, "}\n\n")

	strings.write_string(&b, "// Each value type and the name the inspector lists it by, in the union's order.\n")
	strings.write_string(&b, "value_types := [?]Value_Type{\n")
	for t in _BUILT_IN do fmt.sbprintf(&b, "\t{{%s, %q}},\n", t.type, t.name)
	for r in rows do fmt.sbprintf(&b, "\t{{%s, %q}},\n", _qualified(r), r.name)
	strings.write_string(&b, "}\n\n")

	// An @(init), as tween_gen's: this file is not on disk when the phase
	// table is scanned in the same prebuild.
	strings.write_string(&b, "@(init)\n")
	strings.write_string(&b, "_register_blackboard_value :: proc \"contextless\" () {\n")
	strings.write_string(&b, "\tcontext = runtime.default_context()\n")
	strings.write_string(&b, "\tserialization.register_union_type(Blackboard_Value)\n")
	strings.write_string(&b, "}\n")

	db.emit(w, _ROOT + "/blackboard_value_generated.odin", strings.to_string(b))
	return true
}

@(private = "file")
_qualified :: proc(r: _Row) -> string {
	if r.pkg_path == _ROOT do return r.type_name
	return fmt.tprintf("%s.%s", r.pkg_name, r.type_name)
}
