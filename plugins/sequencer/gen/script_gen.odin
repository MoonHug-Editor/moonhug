package sequencer_gen

// script_gen: emits ScriptUnion and its lifecycle dispatch.
//
// A script variant is a struct embedding `base: Clip_Script` (inside
// sequencer/scripts via the core import, or `<pkg>.Clip_Script` in a plugin
// package importing moonhug:packages/sequencer/core) with any of
// enter_<Name> / tick_<Name> / exit_<Name> / destroy_<Name>. All are
// OPTIONAL: a variant missing a phase's proc gets an empty case, which is
// why the switches must be generated rather than written by hand.
//
//   provide  - join Struct_GenComp + Fields_GenComp, recognise the base
//              field, probe each lifecycle proc, register Script_GenComp.
//   generate - sort, emit script_union_generated.odin.
//
// Prebuild is SYNTAX-ONLY: there is no type resolution, so the base field is
// matched by written name and a variant's procs must live in the SAME FILE
// as its struct (FileHasProc is file-scoped). Both are the plugin contract.

import "core:fmt"
import "core:slice"
import "core:strings"
import "moonhug:prebuild/gen_core"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

// Which lifecycle procs a script variant declares. The type name lives on the
// entity's DeclInfo. Public + registry-owned so any generator may query it.
// The inert zero variant, sorted first into the #no_nil union.
_SCRIPT_NONE :: "ScriptNone"

Script_GenComp :: struct {
	has_enter:   bool,
	has_tick:    bool,
	has_exit:    bool,
	has_destroy: bool,
}

@(init)
_register_script :: proc "contextless" () {
	db.provider("sequencer/script/provide", script_provide)
	db.generator("sequencer/script/generate", script_generate)
}

// The marker base, written either bare (same package as core, via import) or
// qualified (`core.Clip_Script`, `seq_core.Clip_Script`).
_has_base :: proc(fields: []gen_facts.Struct_Field, base: string) -> bool {
	for field in fields {
		if field.name != "base" do continue
		if field.type == base do return true
		if strings.has_suffix(field.type, strings.concatenate({".", base}, context.temp_allocator)) do return true
	}
	return false
}

script_provide :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	structs := db.get_comps(w, gen_facts.Struct_GenComp)
	field_comps := db.get_comps(w, gen_facts.Fields_GenComp)
	scripts := db.get_or_create_comps(w, Script_GenComp)

	m := db.all_of(db.r(decls), db.r(structs), db.r(field_comps))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		fields := db.get(field_comps, entity)
		if !_has_base(fields.fields, "Clip_Script") do continue

		enter_name := strings.concatenate({"enter_", decl.name}, context.temp_allocator)
		tick_name := strings.concatenate({"tick_", decl.name}, context.temp_allocator)
		exit_name := strings.concatenate({"exit_", decl.name}, context.temp_allocator)
		destroy_name := strings.concatenate({"destroy_", decl.name}, context.temp_allocator)
		db.set(scripts, entity, Script_GenComp{
			has_enter   = gen_core.FileHasProc(decl.file, enter_name),
			has_tick    = gen_core.FileHasProc(decl.file, tick_name),
			has_exit    = gen_core.FileHasProc(decl.file, exit_name),
			has_destroy = gen_core.FileHasProc(decl.file, destroy_name),
		})
	}
	return true
}

_Script_Row :: struct {
	type_name: string,
	pkg_name:  string,
	pkg_path:  string,
	using gen:  Script_GenComp,
}

script_generate :: proc(w: ^db.World) -> bool {
	rows: [dynamic]_Script_Row
	defer delete(rows)

	decls := db.get_comps_DeclInfo()
	scripts := db.get_comps(w, Script_GenComp)
	m := db.all_of(db.r(decls), db.r(scripts))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		append(&rows, _Script_Row{
			type_name = decl.name,
			pkg_name  = decl.pkg.name,
			pkg_path  = decl.pkg_path,
			gen       = db.get(scripts, entity)^,
		})
	}
	// The zero variant sorts FIRST — see tween_gen.
	slice.sort_by(rows[:], proc(a, b: _Script_Row) -> bool {
		a_none := a.type_name == _SCRIPT_NONE
		b_none := b.type_name == _SCRIPT_NONE
		if a_none != b_none do return a_none
		if a.type_name != b.type_name do return a.type_name < b.type_name
		return a.pkg_path < b.pkg_path
	})

	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "package sequencer\n\n")
	strings.write_string(&b, "import \"core:encoding/json\"\n")
	strings.write_string(&b, "import \"moonhug:engine\"\n")
	strings.write_string(&b, "import serialization \"moonhug:engine/serialization\"\n")
	strings.write_string(&b, "import core \"moonhug:packages/sequencer/core\"\n")
	_write_variant_imports(&b, rows[:])
	strings.write_string(&b, "\n// Code generated by script_gen. Do not edit.\n")
	strings.write_string(&b, "// A script variant is a struct embedding core.Clip_Script with any of\n")
	strings.write_string(&b, "// enter_<Name> / tick_<Name> / exit_<Name> / destroy_<Name>. Ship one in a\n")
	strings.write_string(&b, "// package importing moonhug:packages/sequencer/core and it joins the union\n")
	strings.write_string(&b, "// on the next prebuild.\n\n")

	// #no_nil, with ScriptNone first so the zero value is inert — see
	// tween_gen for why the zero variant must be a real guid-carrying type
	// rather than the shared base. ScriptNone sorts first by name.
	strings.write_string(&b, "ScriptUnion :: union #no_nil {\n")
	for e in rows do fmt.sbprintf(&b, "\t%s.%s,\n", e.pkg_name, e.type_name)
	strings.write_string(&b, "}\n\n")

	_write_phase(&b, rows[:], "script_enter", "enter", "ctx: ^core.Script_Ctx", "ctx")
	_write_phase(&b, rows[:], "script_tick", "tick", "ctx: ^core.Script_Ctx", "ctx")
	_write_phase(&b, rows[:], "script_exit", "exit", "ctx: ^core.Script_Ctx", "ctx")

	strings.write_string(&b, "// Frees whatever heap the active variant owns and clears the union.\n")
	strings.write_string(&b, "script_destroy :: proc(u: ^ScriptUnion) {\n")
	if _any(rows[:], proc(e: _Script_Row) -> bool { return e.has_destroy }) {
		strings.write_string(&b, "\tswitch &v in u {\n")
		for e in rows {
			fmt.sbprintf(&b, "\tcase %s.%s:\n", e.pkg_name, e.type_name)
			if e.has_destroy {
				fmt.sbprintf(&b, "\t\t%s.destroy_%s(&v)\n", e.pkg_name, e.type_name)
			} else {
				strings.write_string(&b, "\t\t// no heap\n")
			}
		}
		strings.write_string(&b, "\t}\n")
	}
	// #no_nil has no nil state: reset to the zero variant instead.
	strings.write_string(&b, "\tu^ = {}\n")
	strings.write_string(&b, "}\n\n")

	// Guid-keyed union persistence + the union's pointer type for undo
	// capture of [dynamic]ScriptUnion fields.
	strings.write_string(&b, "@(phase={key=SerializationInit, order=2})\n")
	strings.write_string(&b, "script_union_serialization_init :: proc() {\n")
	strings.write_string(&b, "\t@(static) done := false\n")
	strings.write_string(&b, "\tif done do return\n")
	strings.write_string(&b, "\tdone = true\n")
	strings.write_string(&b, "\tjson.register_user_marshaler(ScriptUnion, serialization.union_marshal)\n")
	strings.write_string(&b, "\tjson.register_user_unmarshaler(ScriptUnion, serialization.union_unmarshal)\n")
	strings.write_string(&b, "\tengine.register_pointer_type(ScriptUnion)\n")
	strings.write_string(&b, "}\n")

	db.emit(w, "moonhug/packages/sequencer/script_union_generated.odin", strings.to_string(b))
	return true
}

// One dispatch switch: variants without the phase's proc get an empty case,
// so the exhaustive switch still names every variant.
@(private = "file")
_write_phase :: proc(b: ^strings.Builder, rows: []_Script_Row, proc_name, phase, params, args: string) {
	fmt.sbprintf(b, "%s :: proc(u: ^ScriptUnion, %s) {{\n", proc_name, params)
	fmt.sbprintf(b, "\tswitch &v in u {{\n")
	for e in rows {
		fmt.sbprintf(b, "\tcase %s.%s:\n", e.pkg_name, e.type_name)
		has := phase == "enter" ? e.has_enter : phase == "tick" ? e.has_tick : e.has_exit
		if has {
			fmt.sbprintf(b, "\t\t%s.%s_%s(&v, %s)\n", e.pkg_name, phase, e.type_name, args)
		} else {
			fmt.sbprintf(b, "\t\t// no %s proc\n", phase)
		}
	}
	strings.write_string(b, "\t}\n}\n\n")
}

// One import per variant package, aliased by its declared package name.
@(private = "file")
_write_variant_imports :: proc(b: ^strings.Builder, rows: []_Script_Row) {
	imported: [dynamic]string
	defer delete(imported)
	for e in rows {
		found := false
		for p in imported do if p == e.pkg_path { found = true; break }
		if found do continue
		append(&imported, e.pkg_path)
		fmt.sbprintf(b, "import %s \"moonhug:%s\"\n", e.pkg_name, e.pkg_path[len("moonhug/"):])
	}
}

@(private = "file")
_any :: proc(rows: []_Script_Row, pred: proc(e: _Script_Row) -> bool) -> bool {
	for e in rows do if pred(e) do return true
	return false
}
