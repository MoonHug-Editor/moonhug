package mhgui_gen

// canvas_hit_gen: registers every @(canvas_hit) proc with the mhgui plugin
// (mhgui/raycast.odin).
//
//   @(canvas_hit)
//   canvas_hit_UiShape :: proc(s: ^UiShape, rect: engine.Rect, point: [2]f32) -> bool { ... }
//
// - A hit proc is named canvas_hit_<T>, T a @(component) type of its own
//   package. Anything else stops the build.
// - Each package with such procs gets canvas_hit_generated.odin: an @(init)
//   that registers each one under its type key.
// - An @(init): this file is not on disk when the phase table is scanned in
//   the same prebuild.
//
// A package that loses its last proc keeps a stale generated file until it is
// deleted by hand: it then fails the build loudly, naming the missing proc.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

_HIT :: "canvas_hit"
_MHGUI_PKG :: "moonhug/packages/mhgui"

Canvas_Hit_GenComp :: struct {
	component: string, // T
}

@(init)
_register :: proc "contextless" () {
	db.provider("mhgui/canvas_hit/provide", canvas_hit_provide)
	db.generator("mhgui/canvas_hit/generate", canvas_hit_generate)
}

canvas_hit_provide :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	tagged := db.get_or_create_comps(w, Canvas_Hit_GenComp)

	m := db.all_of(db.r(decls), db.r(procs), db.r(attrs))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		if _, is_hit := gen_facts.attr_find(db.get(attrs, entity), _HIT); !is_hit do continue
		prefix := "canvas_hit_"
		if !strings.has_prefix(decl.name, prefix) || len(decl.name) == len(prefix) {
			fmt.eprintf("canvas_hit_gen: %s:%d: a canvas hit proc is named canvas_hit_<Type>, the component's own name\n", gen_facts.decl_rel_path(decl), decl.decl.pos.line)
			return false
		}
		db.set(tagged, entity, Canvas_Hit_GenComp{component = decl.name[len(prefix):]})
	}
	return true
}

@(private = "file")
_Row :: struct {
	pkg_path:  string,
	pkg_name:  string,
	component: string,
	proc_name: string,
}

canvas_hit_generate :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	tagged := db.get_comps(w, Canvas_Hit_GenComp)
	if tagged == nil do return true

	// Every @(component), by "<package path>/<T>".
	components := make(map[string]bool, context.temp_allocator)
	{
		comps := db.get_comps(w, gen_facts.Component_GenComp)
		m := db.all_of(db.r(decls), db.r(comps))
		defer db.matcher_destroy(&m)
		for entity in db.matched(w, &m) {
			c := db.get(comps, entity)
			if c.kind != .Component do continue
			components[fmt.tprintf("%s/%s", db.get(decls, entity).pkg_path, db.get(decls, entity).name)] = true
		}
	}

	rows := make([dynamic]_Row, context.temp_allocator)
	m := db.all_of(db.r(decls), db.r(tagged))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		t := db.get(tagged, entity)
		if !components[fmt.tprintf("%s/%s", decl.pkg_path, t.component)] {
			fmt.eprintf("canvas_hit_gen: %s:%d: %s is not a @(component) of package %s\n", gen_facts.decl_rel_path(decl), decl.decl.pos.line, t.component, decl.pkg.name)
			return false
		}
		append(&rows, _Row{pkg_path = decl.pkg_path, pkg_name = decl.pkg.name, component = t.component, proc_name = decl.name})
	}
	slice.sort_by(rows[:], proc(a, b: _Row) -> bool {
		if a.pkg_path != b.pkg_path do return a.pkg_path < b.pkg_path
		return a.proc_name < b.proc_name
	})

	for i := 0; i < len(rows); {
		first := rows[i]
		j := i
		for j < len(rows) && rows[j].pkg_path == first.pkg_path do j += 1
		own := first.pkg_path == _MHGUI_PKG
		qual := own ? "" : "mhgui."

		b := strings.builder_make(context.temp_allocator)
		fmt.sbprintf(&b, "package %s\n\n", first.pkg_name)
		strings.write_string(&b, "import \"base:runtime\"\n")
		strings.write_string(&b, "import \"moonhug:packages/engine\"\n")
		if !own do strings.write_string(&b, "import mhgui \"moonhug:packages/mhgui\"\n")
		strings.write_string(&b, "\n// Code generated by mhgui's canvas_hit_gen. Do not edit.\n")
		strings.write_string(&b, "// The package's @(canvas_hit) procs, registered with the mhgui plugin\n")
		strings.write_string(&b, "// under their component's type key.\n\n")
		strings.write_string(&b, "@(init)\n")
		fmt.sbprintf(&b, "_register_%s_canvas_hit :: proc \"contextless\" () {{\n", first.pkg_name)
		strings.write_string(&b, "\tcontext = runtime.default_context()\n")
		for r in rows[i:j] {
			fmt.sbprintf(&b, "\t%scanvas_hit_register(.%s, proc(comp: rawptr, rect: engine.Rect, point: [2]f32) -> bool {{ return %s(cast(^%s)comp, rect, point) }})\n", qual, r.component, r.proc_name, r.component)
		}
		strings.write_string(&b, "}\n")
		db.emit(w, fmt.tprintf("%s/canvas_hit_generated.odin", first.pkg_path), strings.to_string(b))
		i = j
	}
	return true
}
