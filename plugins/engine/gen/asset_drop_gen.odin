package engine_gen

// asset_drop_gen: what a dropped asset becomes (scene_tools/asset_drop.odin).
//
//   @(asset_on_drop={kind="sprite"})
//   asset_on_drop_sprite :: proc(ref: engine.PPtr, parent: engine.Transform_Handle) -> engine.Transform_Handle { ... }
//
//   provide  - recognise procs carrying the attribute: named
//              asset_on_drop_<name>, `kind` a list of file extensions and
//              sub-asset kinds separated by spaces.
//   generate - emit <engine>/editor/scene_tools/asset_on_drop_generated.odin
//              with __asset_on_drop(kind), the proc for a kind or nil. A kind
//              claimed twice stops the build.
//
// The lookup lives in the scene tools and calls INTO plugin editor packages,
// as the gizmo dispatchers do (docs/core/Plugins.md layering).

import "core:fmt"
import "core:slice"
import "core:strings"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

@(private = "file") _ATTRIBUTE :: "asset_on_drop"
@(private = "file") _PREFIX :: "asset_on_drop_"
@(private = "file") _OUT_PACKAGE :: "scene_tools"
@(private = "file") _OUT_PATH :: _ENGINE_EDITOR_PKG_PATH + "/scene_tools/asset_on_drop_generated.odin"

Asset_Drop_GenComp :: struct {
	kinds: []string, // lower case, no dot
}

@(init)
_register_asset_drop :: proc "contextless" () {
	db.provider("asset_drop/provide", asset_drop_provide)
	db.generator("asset_drop/generate", asset_drop_generate)
}

asset_drop_provide :: proc(w: ^db.World) -> bool {
	tagged := db.get_or_create_comps(w, Asset_Drop_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	m := db.all_of(db.r(decls), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		args, found := gen_facts.attr_find(db.get(attrs, entity), _ATTRIBUTE)
		if !found do continue
		where_ := fmt.tprintf("%s:%d", gen_facts.decl_rel_path(decl), decl.decl.pos.line)
		if db.get(procs, entity) == nil || !strings.has_prefix(decl.name, _PREFIX) || len(decl.name) == len(_PREFIX) {
			fmt.eprintf("asset_drop_gen: %s: %s must be a proc named %s<name>\n", where_, decl.name, _PREFIX)
			return false
		}
		if decl.pkg_path == "moonhug/editor" {
			fmt.eprintf("asset_drop_gen: %s: @(%s) cannot live in the editor root package, the scene tools would import it\n", where_, _ATTRIBUTE)
			return false
		}
		kinds := make([dynamic]string)
		for k in strings.fields(args.fields["kind"], context.temp_allocator) {
			k := strings.to_lower(strings.trim_prefix(k, "."))
			if k != "" do append(&kinds, k)
		}
		if len(kinds) == 0 {
			fmt.eprintf("asset_drop_gen: %s: @(%s) names what it takes with kind=\"ext or sub-asset kind\"\n", where_, _ATTRIBUTE)
			return false
		}
		db.set(tagged, entity, Asset_Drop_GenComp{kinds = kinds[:]})
	}
	return true
}

@(private = "file")
_Drop_Row :: struct {
	kind:     string,
	call:     string, // the proc, qualified outside the scene tools
	where_:   string,
	pkg_name: string, // "" in the scene tools
	pkg_path: string,
}

asset_drop_generate :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	tagged := db.get_comps(w, Asset_Drop_GenComp)

	rows := make([dynamic]_Drop_Row, context.temp_allocator)
	if tagged != nil {
		m := db.all_of(db.r(decls), db.r(tagged)); defer db.matcher_destroy(&m)
		for entity in db.matched(w, &m) {
			decl := db.get(decls, entity)
			own := decl.pkg_path == _ENGINE_EDITOR_PKG_PATH + "/scene_tools"
			row := _Drop_Row{
				call     = own ? decl.name : fmt.tprintf("%s.%s", decl.pkg.name, decl.name),
				where_   = fmt.tprintf("%s:%d", gen_facts.decl_rel_path(decl), decl.decl.pos.line),
				pkg_name = own ? "" : decl.pkg.name,
				pkg_path = decl.pkg_path,
			}
			for k in db.get(tagged, entity).kinds {
				row.kind = k
				append(&rows, row)
			}
		}
	}
	slice.sort_by(rows[:], proc(a, b: _Drop_Row) -> bool { return a.kind < b.kind })
	for i in 1 ..< len(rows) {
		if rows[i].kind == rows[i - 1].kind {
			fmt.eprintf("asset_drop_gen: kind %q is taken by %s (%s) and %s (%s): one @(%s) proc per kind\n", rows[i].kind, rows[i - 1].call, rows[i - 1].where_, rows[i].call, rows[i].where_, _ATTRIBUTE)
			return false
		}
	}

	b := strings.builder_make(context.temp_allocator)
	fmt.sbprintf(&b, "package %s\n\n", _OUT_PACKAGE)
	imports := make(map[string]string, context.temp_allocator)
	for r in rows do if r.pkg_name != "" do imports[r.pkg_name] = r.pkg_path
	names := make([dynamic]string, context.temp_allocator)
	for name in imports do append(&names, name)
	slice.sort(names[:])
	for name in names do fmt.sbprintf(&b, "import %s %q\n", name, gen_facts.pkg_import_path(imports[name]))
	if len(names) > 0 do strings.write_string(&b, "\n")
	strings.write_string(&b, "// Code generated by asset_drop_gen. Do not edit.\n\n")
	strings.write_string(&b, "// The @(asset_on_drop) proc for a kind (asset_drop_kind), nil when none.\n")
	strings.write_string(&b, "__asset_on_drop :: proc(kind: string) -> Asset_Drop_Proc {\n")
	strings.write_string(&b, "\tswitch kind {\n")
	for r in rows do fmt.sbprintf(&b, "\tcase %q: return %s\n", r.kind, r.call)
	strings.write_string(&b, "\t}\n\treturn nil\n}\n")
	db.emit(w, _OUT_PATH, strings.to_string(b))
	return true
}
