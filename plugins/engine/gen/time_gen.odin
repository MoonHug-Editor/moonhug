package engine_gen

// time_gen: the engine's Time enum (plugins/engine/time.odin).
//
// - The built-in timelines come first: Update, Fixed, Unscaled.
// - A package adds timelines with a `Time_Extra` enum of its own. Its values
//   follow the built-in ones, packages in first-seen order, duplicates once.
// - The output is time_generated.odin in the engine package, so every
//   package names a timeline as `engine.Time.<Name>`.
//
//   Time_Extra :: enum {
//       Bullet_Time,
//       Cutscene,
//   }

import "core:fmt"
import "core:strings"
import "moonhug:prebuild/gen_core"
import db "moonhug:prebuild/gen_db"

_TIME_OUT_FILE :: _ENGINE_PKG_PATH + "/time_generated.odin"

// In the order the enum lists them. time.odin reads these three by name.
_BUILTIN_TIME_NAMES :: []string{"Update", "Fixed", "Unscaled"}

@(init)
_register_time_gen :: proc "contextless" () {
	db.generator("time/generate", time_generate)
}

time_generate :: proc(w: ^db.World) -> bool {
	names := make([dynamic]string, context.temp_allocator)
	for n in _BUILTIN_TIME_NAMES do append(&names, n)

	seen_pkgs := make(map[string]bool, context.temp_allocator)
	decls := db.get_comps_DeclInfo()
	for &d in decls.rows[:db.comps_len(decls)] {
		if d.pkg == nil || d.name != "Time_Extra" || seen_pkgs[d.pkg_path] do continue
		seen_pkgs[d.pkg_path] = true
		extra := gen_core.EnumFieldNames(d.decl)
		defer delete(extra)
		if len(extra) == 0 {
			fmt.eprintfln("prebuild: time: %s.Time_Extra must be an enum with at least one value", d.pkg.name)
			return false
		}
		for n in extra {
			already := false
			for existing in names do if existing == n do already = true
			if !already do append(&names, strings.clone(n, context.temp_allocator))
		}
	}
	if len(names) > 255 {
		fmt.eprintfln("prebuild: time: %d timelines, the Time enum holds 255", len(names))
		return false
	}

	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "package engine\n\n")
	strings.write_string(&b, "// Code generated by time_gen. Do not edit.\n")
	strings.write_string(&b, "// The built-in timelines, then every package's Time_Extra values (time.odin).\n\n")
	strings.write_string(&b, "Time :: enum u8 {\n")
	for n in names do fmt.sbprintf(&b, "\t%s,\n", n)
	strings.write_string(&b, "}\n")
	db.emit(w, _TIME_OUT_FILE, strings.to_string(b))
	return true
}
