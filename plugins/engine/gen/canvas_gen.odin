package engine_gen

// canvas_gen: the procs a package plugs into the engine's canvas tree
// (plugins/engine/ui_canvas.odin).
//
//   @(canvas_graphic)
//   canvas_populate_Image :: proc(img: ^Image, rect: engine.Rect, out: ^[dynamic]engine.Graphic_Quad) { ... }
//
//   @(canvas_layout)
//   canvas_layout_groups :: proc(tH: engine.Transform_Handle, rect: engine.Rect, children: []engine.Transform_Handle, out: []engine.Rect) -> bool { ... }
//
//   A graphic's name is the contract: `canvas_populate_<T>`, T a struct of
//   the same package with a `graphic` field, so the generated descriptor
//   carries its type key, the field's offset and a thunk that casts the
//   component for the proc. A layout proc's name is free.
//
//   generate - editor/scene_tools/canvas_editor_generated.odin: every
//              declaration, registered from @(init) for the editor.
//            - <host>/canvas_generated.odin per runnable package:
//              __register_canvas(), its own and the library packages',
//              called by __standalone_run (update_gen).

import "core:fmt"
import "core:slice"
import "core:strings"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

Canvas_GenComp :: struct {
	layout: bool,   // @(canvas_layout), else @(canvas_graphic)
	type_name: string, // the graphic's component type, "" for a layout
	editor: bool,
}

_CANVAS_EDITOR_OUT_FILE :: _ENGINE_EDITOR_PKG_PATH + "/scene_tools/canvas_editor_generated.odin"

@(init)
_register_canvas_gen :: proc "contextless" () {
	db.provider("canvas/provide", canvas_provide)
	db.generator("canvas/generate", canvas_generate)
}

canvas_provide :: proc(w: ^db.World) -> bool {
	comps := db.get_or_create_comps(w, Canvas_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	fields := db.get_comps(w, gen_facts.Fields_GenComp)
	m := db.all_of(db.r(decls), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" || !strings.has_prefix(decl.pkg_path, _PACKAGES_PREFIX) do continue
		attr_set := db.get(attrs, entity)
		_, is_graphic := gen_facts.attr_find(attr_set, "canvas_graphic")
		_, is_layout := gen_facts.attr_find(attr_set, "canvas_layout")
		if !is_graphic && !is_layout do continue
		where_ := fmt.tprintf("%s:%d", gen_facts.decl_rel_path(decl), decl.decl.pos.line)
		if db.get(procs, entity) == nil {
			fmt.eprintfln("prebuild: %s: %s must be a proc", where_, decl.name)
			return false
		}
		editor := strings.has_suffix(decl.pkg_path, "/editor") || strings.contains(decl.pkg_path, "/editor/")
		if is_layout {
			db.set(comps, entity, Canvas_GenComp{layout = true, editor = editor})
			continue
		}
		if !strings.has_prefix(decl.name, "canvas_populate_") || len(decl.name) == len("canvas_populate_") {
			fmt.eprintfln("prebuild: %s: a canvas graphic is named canvas_populate_<Type>, the component's own name", where_)
			return false
		}
		type_name := decl.name[len("canvas_populate_"):]
		// The type: a struct of the same package with a `graphic` field.
		found := false
		for &d, i in decls.rows[:db.comps_len(decls)] {
			if d.pkg_path != decl.pkg_path || d.name != type_name do continue
			f := db.get(fields, db.get_entity(decls, i))
			if f == nil do continue
			for field in f.fields do if field.name == "graphic" { found = true; break }
			break
		}
		if !found {
			fmt.eprintfln("prebuild: %s: canvas_populate_%s needs a struct %s in its package with a `graphic` field (engine.Graphic)", where_, type_name, type_name)
			return false
		}
		db.set(comps, entity, Canvas_GenComp{type_name = type_name, editor = editor})
	}
	return true
}

@(private = "file")
_Canvas_Row :: struct {
	name:      string,
	pkg:       string,
	path:      string,
	type_name: string, // "" for a layout
	editor:    bool,
}

canvas_generate :: proc(w: ^db.World) -> bool {
	rows := make([dynamic]_Canvas_Row, context.temp_allocator)
	decls := db.get_comps_DeclInfo()
	comps := db.get_comps(w, Canvas_GenComp)
	m := db.all_of(db.r(decls), db.r(comps)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		c := db.get(comps, entity)
		append(&rows, _Canvas_Row{name = decl.name, pkg = decl.pkg.name, path = decl.pkg_path, type_name = c.type_name, editor = c.editor})
	}
	slice.sort_by(rows[:], proc(a, b: _Canvas_Row) -> bool {
		if a.pkg != b.pkg do return a.pkg < b.pkg
		return a.name < b.name
	})

	{
		b := strings.builder_make()
		defer strings.builder_destroy(&b)
		strings.write_string(&b, "package scene_tools\n\n")
		strings.write_string(&b, "// Code generated by canvas_gen. Do not edit.\n")
		strings.write_string(&b, "// Every canvas graphic and layout, for the editor (plugins/engine/ui_canvas.odin).\n\n")
		strings.write_string(&b, "import \"base:runtime\"\n")
		_write_canvas_imports(&b, rows[:], "")
		strings.write_string(&b, "\n@(init)\n_register_canvas :: proc \"contextless\" () {\n\tcontext = runtime.default_context()\n")
		for r in rows do _write_canvas_register(&b, r, "")
		strings.write_string(&b, "}\n")
		db.emit(w, _CANVAS_EDITOR_OUT_FILE, strings.to_string(b))
	}

	runnables := gen_facts.runnable_packages(w)
	defer delete(runnables)
	for host in runnables {
		mine := make([dynamic]_Canvas_Row, context.temp_allocator)
		for r in rows {
			if r.editor do continue
			if r.pkg != host.name && gen_facts.is_runnable(runnables[:], r.pkg) do continue
			append(&mine, r)
		}
		b := strings.builder_make()
		defer strings.builder_destroy(&b)
		fmt.sbprintf(&b, "package %s\n\n", host.name)
		strings.write_string(&b, "// Code generated by canvas_gen. Do not edit.\n")
		strings.write_string(&b, "// This package's canvas graphics and layouts and the library packages', registered by __standalone_run.\n\n")
		_write_canvas_imports(&b, mine[:], host.name)
		strings.write_string(&b, "\n__register_canvas :: proc() {\n")
		for r in mine do _write_canvas_register(&b, r, host.name)
		strings.write_string(&b, "}\n")
		db.emit(w, fmt.tprintf("%s/canvas_generated.odin", host.path), strings.to_string(b))
	}
	return true
}

// One registration. `own_pkg` is the generated file's package: its own
// names go unqualified.
@(private = "file")
_write_canvas_register :: proc(b: ^strings.Builder, r: _Canvas_Row, own_pkg: string) {
	q := r.pkg == own_pkg ? "" : fmt.tprintf("%s.", r.pkg)
	if r.type_name == "" {
		fmt.sbprintf(b, "\tengine.canvas_layout_register(%s%s)\n", q, r.name)
		return
	}
	fmt.sbprintf(b, "\tengine.canvas_graphic_register({{\n")
	fmt.sbprintf(b, "\t\tkey            = .%s,\n", r.type_name)
	fmt.sbprintf(b, "\t\tgraphic_offset = offset_of(%s%s, graphic),\n", q, r.type_name)
	fmt.sbprintf(b, "\t\tpopulate       = proc(comp: rawptr, rect: engine.Rect, out: ^[dynamic]engine.Graphic_Quad) {{ %s%s(cast(^%s%s)comp, rect, out) }},\n", q, r.name, q, r.type_name)
	strings.write_string(b, "\t})\n")
}

@(private = "file")
_write_canvas_imports :: proc(b: ^strings.Builder, rows: []_Canvas_Row, own_pkg: string) {
	fmt.sbprintf(b, "import engine %q\n", _ENGINE_IMPORT)
	names := make([dynamic]string, context.temp_allocator)
	paths := make(map[string]string, context.temp_allocator)
	for r in rows {
		if r.pkg == own_pkg || r.pkg == "engine" || r.pkg in paths do continue
		paths[r.pkg] = gen_facts.pkg_import_path(r.path)
		append(&names, r.pkg)
	}
	slice.sort(names[:])
	for name in names do fmt.sbprintf(b, "import %s %q\n", name, paths[name])
}
