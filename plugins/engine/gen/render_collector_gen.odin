package engine_gen

// render_collector_gen: the procs that turn renderer components into draw
// commands (plugins/engine/render.odin, Render_Collector).
//
//   @(render_collector)
//   collect_sprites :: proc(view: engine.Render_View, out: ^[dynamic]engine.Render_Command) { ... }
//
//   generate - editor/scene_tools/render_collectors_editor_generated.odin:
//              every collector, registered from @(init) for the editor.
//            - <host>/render_collectors_generated.odin per runnable package:
//              __register_render_collectors(), its own collectors and the
//              library packages', called by __standalone_run (update_gen).
//
// The engine's own collectors (meshes, skinned meshes, the canvas) declare
// the attribute like a package's, so render_collect_commands runs one list.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

Render_Collector_GenComp :: struct {
	editor: bool, // declared in an editor/ package
}

_COLLECTORS_EDITOR_OUT_FILE :: _ENGINE_EDITOR_PKG_PATH + "/scene_tools/render_collectors_editor_generated.odin"

@(init)
_register_render_collector_gen :: proc "contextless" () {
	db.provider("render_collector/provide", render_collector_provide)
	db.generator("render_collector/generate", render_collector_generate)
}

render_collector_provide :: proc(w: ^db.World) -> bool {
	collectors := db.get_or_create_comps(w, Render_Collector_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	m := db.all_of(db.r(decls), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" || !strings.has_prefix(decl.pkg_path, _PACKAGES_PREFIX) do continue
		if _, found := gen_facts.attr_find(db.get(attrs, entity), "render_collector"); !found do continue
		if db.get(procs, entity) == nil {
			fmt.eprintfln("prebuild: render collector %s.%s must be a proc(view: Render_View, out: ^[dynamic]Render_Command)", decl.pkg.name, decl.name)
			return false
		}
		db.set(collectors, entity, Render_Collector_GenComp{
			editor = strings.has_suffix(decl.pkg_path, "/editor") || strings.contains(decl.pkg_path, "/editor/"),
		})
	}
	return true
}

@(private = "file")
_Collector_Row :: struct {
	name:   string,
	pkg:    string,
	path:   string,
	editor: bool,
}

render_collector_generate :: proc(w: ^db.World) -> bool {
	rows := make([dynamic]_Collector_Row, context.temp_allocator)
	decls := db.get_comps_DeclInfo()
	collectors := db.get_comps(w, Render_Collector_GenComp)
	m := db.all_of(db.r(decls), db.r(collectors)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		append(&rows, _Collector_Row{name = decl.name, pkg = decl.pkg.name, path = decl.pkg_path, editor = db.get(collectors, entity).editor})
	}
	slice.sort_by(rows[:], proc(a, b: _Collector_Row) -> bool {
		if a.pkg != b.pkg do return a.pkg < b.pkg
		return a.name < b.name
	})

	// The editor: every collector, from @(init).
	{
		b := strings.builder_make()
		defer strings.builder_destroy(&b)
		strings.write_string(&b, "package scene_tools\n\n")
		strings.write_string(&b, "// Code generated by render_collector_gen. Do not edit.\n")
		strings.write_string(&b, "// Every render collector, for the editor (plugins/engine/render.odin).\n\n")
		strings.write_string(&b, "import \"base:runtime\"\n")
		_write_collector_imports(&b, rows[:], "")
		strings.write_string(&b, "\n@(init)\n_register_render_collectors :: proc \"contextless\" () {\n\tcontext = runtime.default_context()\n")
		for r in rows do fmt.sbprintf(&b, "\tengine.render_register_collector(%s.%s)\n", r.pkg, r.name)
		strings.write_string(&b, "}\n")
		db.emit(w, _COLLECTORS_EDITOR_OUT_FILE, strings.to_string(b))
	}

	// Each runnable package: its own and the library packages', never an
	// editor collector or another runnable's. A plain proc, not @(init), so
	// the editor, which imports the same package, registers nothing twice.
	runnables := gen_facts.runnable_packages(w)
	defer delete(runnables)
	for host in runnables {
		mine := make([dynamic]_Collector_Row, context.temp_allocator)
		for r in rows {
			if r.editor do continue
			if r.pkg != host.name && gen_facts.is_runnable(runnables[:], r.pkg) do continue
			append(&mine, r)
		}
		b := strings.builder_make()
		defer strings.builder_destroy(&b)
		fmt.sbprintf(&b, "package %s\n\n", host.name)
		strings.write_string(&b, "// Code generated by render_collector_gen. Do not edit.\n")
		strings.write_string(&b, "// This package's render collectors and the library packages', registered by __standalone_run.\n\n")
		_write_collector_imports(&b, mine[:], host.name)
		strings.write_string(&b, "\n__register_render_collectors :: proc() {\n")
		for r in mine {
			if r.pkg == host.name {
				fmt.sbprintf(&b, "\tengine.render_register_collector(%s)\n", r.name)
			} else {
				fmt.sbprintf(&b, "\tengine.render_register_collector(%s.%s)\n", r.pkg, r.name)
			}
		}
		strings.write_string(&b, "}\n")
		db.emit(w, fmt.tprintf("%s/render_collectors_generated.odin", host.path), strings.to_string(b))
	}
	return true
}

// The engine first, then every collector package but the file's own, by name.
@(private = "file")
_write_collector_imports :: proc(b: ^strings.Builder, rows: []_Collector_Row, own_pkg: string) {
	fmt.sbprintf(b, "import engine %q\n", _ENGINE_IMPORT)
	names := make([dynamic]string, context.temp_allocator)
	paths := make(map[string]string, context.temp_allocator)
	for r in rows {
		if r.pkg == own_pkg || r.pkg == "engine" || r.pkg in paths do continue
		paths[r.pkg] = gen_facts.pkg_import_path(r.path)
		append(&names, r.pkg)
	}
	slice.sort(names[:])
	for name in names do fmt.sbprintf(b, "import %s %q\n", name, paths[name])
}
