package engine_gen

// asset_preload_gen: the procs that load one asset before its first use
// (plugins/engine/asset_preload.odin).
//
//   @(asset_preload={ext="mp3,wav,ogg"})
//   asset_preload_audio_clip :: proc(ref: engine.PPtr) { ... }
//
//   The name is the contract: `asset_preload_<name>`, the name free. `ext`
//   lists the asset types the proc loads, separated by commas.
//
//   generate - moonhug/registration/asset_preloads_generated.odin: every
//              declaration, registered from @(init) for the editor and the
//              tests.
//            - <host>/asset_preloads_generated.odin per runnable package:
//              __register_asset_preloads(), its own procs and the library
//              packages', called by __standalone_run (update_gen).

import "core:fmt"
import "core:slice"
import "core:strings"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

Asset_Preload_GenComp :: struct {
	ext: string,
}

_PRELOADS_EDITOR_OUT_FILE :: "moonhug/registration/asset_preloads_generated.odin"

@(init)
_register_asset_preload_gen :: proc "contextless" () {
	db.provider("asset_preload/provide", asset_preload_provide)
	db.generator("asset_preload/generate", asset_preload_generate)
}

asset_preload_provide :: proc(w: ^db.World) -> bool {
	preloads := db.get_or_create_comps(w, Asset_Preload_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	m := db.all_of(db.r(decls), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" || !strings.has_prefix(decl.pkg_path, _PACKAGES_PREFIX) do continue
		args, found := gen_facts.attr_find(db.get(attrs, entity), "asset_preload")
		if !found do continue
		if db.get(procs, entity) == nil || !strings.has_prefix(decl.name, "asset_preload_") || len(decl.name) == len("asset_preload_") {
			fmt.eprintfln("prebuild: asset_preload: %s.%s must be a proc(ref: PPtr) named asset_preload_<name>", decl.pkg.name, decl.name)
			return false
		}
		if args.fields["ext"] == "" {
			fmt.eprintfln("prebuild: asset_preload: %s.%s needs ext, the asset types it loads: ext=\"png,jpg\"", decl.pkg.name, decl.name)
			return false
		}
		db.set(preloads, entity, Asset_Preload_GenComp{ext = args.fields["ext"]})
	}
	return true
}

@(private = "file")
_Preload_Row :: struct {
	name: string,
	ext:  string,
	pkg:  string,
	path: string,
}

asset_preload_generate :: proc(w: ^db.World) -> bool {
	rows := make([dynamic]_Preload_Row, context.temp_allocator)
	decls := db.get_comps_DeclInfo()
	preloads := db.get_comps(w, Asset_Preload_GenComp)
	m := db.all_of(db.r(decls), db.r(preloads)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		append(&rows, _Preload_Row{name = decl.name, ext = db.get(preloads, entity).ext, pkg = decl.pkg.name, path = decl.pkg_path})
	}
	slice.sort_by(rows[:], proc(a, b: _Preload_Row) -> bool {
		if a.pkg != b.pkg do return a.pkg < b.pkg
		return a.name < b.name
	})

	// The editor and the tests: every proc, from @(init).
	{
		b := strings.builder_make()
		defer strings.builder_destroy(&b)
		strings.write_string(&b, "package registration\n\n")
		strings.write_string(&b, "// Code generated by asset_preload_gen. Do not edit.\n")
		strings.write_string(&b, "// Every @(asset_preload) proc, for the editor and the tests (plugins/engine/asset_preload.odin).\n\n")
		strings.write_string(&b, "import \"base:runtime\"\n")
		_write_preload_imports(&b, rows[:], "")
		strings.write_string(&b, "\n@(init)\n_register_asset_preloads :: proc \"contextless\" () {\n\tcontext = runtime.default_context()\n")
		for r in rows do fmt.sbprintf(&b, "\tengine.asset_preload_add(%q, %s.%s)\n", r.ext, r.pkg, r.name)
		strings.write_string(&b, "}\n")
		db.emit(w, _PRELOADS_EDITOR_OUT_FILE, strings.to_string(b))
	}

	// Each runnable package: its own and the library packages', never
	// another runnable's. A plain proc, not @(init), so the editor, which
	// imports the same package, registers nothing twice.
	runnables := gen_facts.runnable_packages(w)
	defer delete(runnables)
	for host in runnables {
		mine := make([dynamic]_Preload_Row, context.temp_allocator)
		for r in rows {
			if strings.has_suffix(r.path, "/editor") || strings.contains(r.path, "/editor/") do continue
			if r.pkg != host.name && gen_facts.is_runnable(runnables[:], r.pkg) do continue
			append(&mine, r)
		}
		b := strings.builder_make()
		defer strings.builder_destroy(&b)
		fmt.sbprintf(&b, "package %s\n\n", host.name)
		strings.write_string(&b, "// Code generated by asset_preload_gen. Do not edit.\n")
		strings.write_string(&b, "// This package's @(asset_preload) procs and the library packages', registered by __standalone_run.\n\n")
		_write_preload_imports(&b, mine[:], host.name)
		strings.write_string(&b, "\n__register_asset_preloads :: proc() {\n")
		for r in mine {
			if r.pkg == host.name {
				fmt.sbprintf(&b, "\tengine.asset_preload_add(%q, %s)\n", r.ext, r.name)
			} else {
				fmt.sbprintf(&b, "\tengine.asset_preload_add(%q, %s.%s)\n", r.ext, r.pkg, r.name)
			}
		}
		strings.write_string(&b, "}\n")
		db.emit(w, fmt.tprintf("%s/asset_preloads_generated.odin", host.path), strings.to_string(b))
	}
	return true
}

// The engine first, then every other package but the file's own, by name.
@(private = "file")
_write_preload_imports :: proc(b: ^strings.Builder, rows: []_Preload_Row, own_pkg: string) {
	fmt.sbprintf(b, "import engine %q\n", _ENGINE_IMPORT)
	names := make([dynamic]string, context.temp_allocator)
	paths := make(map[string]string, context.temp_allocator)
	for r in rows {
		if r.pkg == own_pkg || r.pkg == "engine" || r.pkg in paths do continue
		paths[r.pkg] = gen_facts.pkg_import_path(r.path)
		append(&names, r.pkg)
	}
	slice.sort(names[:])
	for name in names do fmt.sbprintf(b, "import %s %q\n", name, paths[name])
}
