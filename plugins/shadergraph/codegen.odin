package shadergraph

// GLSL from a graph: the surface shader the importer compiles, in the shape a
// hand-written one has (plugins/engine/docs/Materials.md "Surface shaders"):
//
//   layout(set = 3, binding = 1) uniform MaterialUBO { ...properties... };
//   layout(set = 2, binding = N) uniform sampler2D <texture property>;
//   void surface(inout Surface s) { ...one line per node... s.albedo = ...; }
//
// Only nodes that reach the Surface node are emitted, each once, as one
// variable per output (`n<id>_<port>`). An input nothing links into becomes
// its literal. A Surface input nothing links into is left alone, so the
// template's preset stands, which is what makes an empty graph the lit shader.

import "core:fmt"
import "core:strings"

// A problem the generator found. Compile errors are the importer's.
Codegen_Error :: struct {
	node_id: i32, // 0 for a graph-level problem
	message: string,
}

Codegen_Result :: struct {
	glsl:   string,
	errors: [dynamic]Codegen_Error,
}

// The generated shader, or the errors that stopped it (both temp-allocated
// unless `allocator` says otherwise).
generate :: proc(g: ^Shader_Graph, allocator := context.temp_allocator) -> (result: Codegen_Result, ok: bool) {
	context.allocator = allocator
	result.errors = make([dynamic]Codegen_Error)
	b := strings.builder_make()

	// --- Properties
	strings.write_string(&b, "// Generated by Shader Graph. Edit the .shadergraph, not this.\n\n")
	ubo := make([dynamic]^Graph_Property)
	textures := make([dynamic]^Graph_Property)
	for &p in g.properties {
		if p.kind == .Texture {
			append(&textures, &p)
		} else {
			append(&ubo, &p)
		}
	}
	if len(ubo) > 0 {
		strings.write_string(&b, "layout(set = 3, binding = 1) uniform MaterialUBO {\n")
		for p in ubo do fmt.sbprintf(&b, "    %s %s;\n", _glsl_type(prop_port_type(p.kind)), prop_identifier(p.name))
		strings.write_string(&b, "};\n\n")
	}
	for p, i in textures {
		fmt.sbprintf(&b, "layout(set = 2, binding = %d) uniform sampler2D %s;\n", i + 1, prop_identifier(p.name))
	}
	if len(textures) > 0 do strings.write_string(&b, "\n")

	// --- surface()
	surface: ^Graph_Node
	for &n in g.nodes {
		if n.kind != SURFACE_KIND do continue
		if surface != nil {
			append(&result.errors, Codegen_Error{n.id, "more than one Surface node"})
		}
		surface = &n
	}
	if surface == nil {
		append(&result.errors, Codegen_Error{0, "no Surface node"})
	}

	strings.write_string(&b, "void surface(inout Surface s) {\n")
	gen := _Gen{g = g, b = &b, errors = &result.errors, emitted = make(map[i32]_Emitted)}
	if surface != nil {
		def, _ := node_def(SURFACE_KIND)
		fields := []string{"s.albedo", "s.alpha", "s.normal", "s.emissive", "s.metallic", "s.smoothness", "s.occlusion"}
		for in_port, i in def.inputs {
			link, linked := graph_input_link(g, surface.id, i32(i))
			if !linked do continue
			expr, etype, eok := _emit_node_output(&gen, link.from_node, link.from_port)
			if !eok do continue
			fmt.sbprintf(&b, "    %s = %s;\n", fields[i], _coerce(expr, etype, in_port.type))
		}
	}
	strings.write_string(&b, "}\n")

	result.glsl = strings.to_string(b)
	return result, len(result.errors) == 0
}

// A property name as a GLSL identifier: letters, digits and underscores,
// never starting with a digit, never empty. The material inspector shows the
// reflected member, so the name is kept where it is already an identifier.
prop_identifier :: proc(name: string, allocator := context.temp_allocator) -> string {
	b := strings.builder_make(allocator)
	for r, i in name {
		ok := r == '_' || (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (i > 0 && r >= '0' && r <= '9')
		strings.write_rune(&b, ok ? r : '_')
	}
	if strings.builder_len(b) == 0 do strings.write_string(&b, "prop")
	return strings.to_string(b)
}

@(private = "file")
_Emitted :: struct {
	types: [8]Port_Type, // per output
}

@(private = "file")
_Gen :: struct {
	g:       ^Shader_Graph,
	b:       ^strings.Builder,
	errors:  ^[dynamic]Codegen_Error,
	emitted: map[i32]_Emitted,
	depth:   int, // guards a cycle a bad file could hold
}

// The variable holding node `id`'s output `port`, emitting the node (and
// what it depends on) first. False after reporting a problem.
@(private = "file")
_emit_node_output :: proc(gen: ^_Gen, id, port: i32) -> (expr: string, type: Port_Type, ok: bool) {
	n := graph_find_node(gen.g, id)
	if n == nil {
		append(gen.errors, Codegen_Error{id, "a link names a node that does not exist"})
		return "", .Float, false
	}
	if e, done := gen.emitted[id]; done {
		return fmt.tprintf("n%d_%d", id, port), e.types[port], true
	}
	if gen.depth > 256 {
		append(gen.errors, Codegen_Error{id, "the graph has a cycle"})
		return "", .Float, false
	}
	def, has_def := node_def(n.kind)
	if !has_def {
		append(gen.errors, Codegen_Error{id, fmt.tprintf("unknown node kind %q", n.kind)})
		return "", .Float, false
	}
	if int(port) >= len(def.outputs) || int(port) >= 8 {
		append(gen.errors, Codegen_Error{id, fmt.tprintf("%s has no output %d", n.kind, port)})
		return "", .Float, false
	}
	gen.depth += 1
	defer gen.depth -= 1

	// Inputs first: the expression of each, and the Dyn type the node resolves to.
	inputs := make([]string, len(def.inputs))
	in_types := make([]Port_Type, len(def.inputs))
	dyn := Port_Type.Float
	for in_port, i in def.inputs {
		if link, linked := graph_input_link(gen.g, id, i32(i)); linked {
			expr, etype, eok := _emit_node_output(gen, link.from_node, link.from_port)
			if !eok do return "", .Float, false
			inputs[i], in_types[i] = expr, etype
			if in_port.type == .Dyn && etype > dyn do dyn = etype
		} else {
			lit := i < len(n.values) ? n.values[i] : in_port.default
			t := in_port.type
			if t == .Dyn do t = .Float // a literal on a Dyn port follows the node
			inputs[i], in_types[i] = _literal(lit, t), t
		}
	}
	e: _Emitted
	switch n.kind {
	case PROPERTY_KIND:
		p := graph_find_property(gen.g, n.property)
		if p == nil || p.kind == .Texture {
			append(gen.errors, Codegen_Error{id, fmt.tprintf("Property node names no property %q", n.property)})
			return "", .Float, false
		}
		e.types[0] = prop_port_type(p.kind)
		fmt.sbprintf(gen.b, "    %s n%d_0 = %s;\n", _glsl_type(e.types[0]), id, prop_identifier(p.name))
	case SAMPLE_TEXTURE_KIND:
		p := graph_find_property(gen.g, n.property)
		if p == nil || p.kind != .Texture {
			append(gen.errors, Codegen_Error{id, fmt.tprintf("Sample Texture names no texture property %q", n.property)})
			return "", .Float, false
		}
		uv := _texture_uv(gen, id, inputs[0], in_types[0])
		e.types = {.Vec4, .Vec3, .Float, .Float, .Float, .Float, .Float, .Float}
		// A color texture, stored as sRGB: decoded to the linear light the
		// template lights in (surface.glsl srgb_to_linear).
		fmt.sbprintf(gen.b, "    vec4 n%d_0 = srgb_to_linear(texture(%s, %s));\n", id, prop_identifier(p.name), uv)
		fmt.sbprintf(gen.b, "    vec3 n%d_1 = n%d_0.rgb;\n", id, id)
		fmt.sbprintf(gen.b, "    float n%d_2 = n%d_0.a;\n", id, id)
	case NORMAL_MAP_KIND:
		p := graph_find_property(gen.g, n.property)
		if p == nil || p.kind != .Texture {
			append(gen.errors, Codegen_Error{id, fmt.tprintf("Normal Map names no texture property %q", n.property)})
			return "", .Float, false
		}
		uv := _texture_uv(gen, id, inputs[0], in_types[0])
		strength := _coerce(inputs[1], in_types[1], .Float)
		e.types[0] = .Vec3
		// Normal data, not color: unpacked, never sRGB-decoded.
		fmt.sbprintf(gen.b, "    vec3 n%d_0 = perturb_normal(texture(%s, %s).xyz * 2.0 - 1.0, %s);\n", id, prop_identifier(p.name), uv, strength)
	case SURFACE_KIND:
		append(gen.errors, Codegen_Error{id, "the Surface node has no outputs"})
		return "", .Float, false
	case:
		for out_port, oi in def.outputs {
			t := out_port.type == .Dyn ? dyn : out_port.type
			e.types[oi] = t
			// Dyn inputs go in at the node's type, typed inputs at their own.
			expr := def.glsl[oi]
			for in_port, i in def.inputs {
				target := in_port.type == .Dyn ? dyn : in_port.type
				expr, _ = strings.replace_all(expr, fmt.tprintf("$%d", i), _coerce(inputs[i], in_types[i], target))
			}
			fmt.sbprintf(gen.b, "    %s n%d_%d = %s;\n", _glsl_type(t), id, oi, expr)
		}
	}
	gen.emitted[id] = e
	return fmt.tprintf("n%d_%d", id, port), e.types[port], true
}

@(private = "file")
_glsl_type :: proc(t: Port_Type) -> string {
	switch t {
	case .Float: return "float"
	case .Vec2:  return "vec2"
	case .Vec3:  return "vec3"
	case .Vec4, .Dyn: return "vec4"
	}
	return "float"
}

@(private = "file")
_components :: proc(t: Port_Type) -> int {
	switch t {
	case .Float: return 1
	case .Vec2:  return 2
	case .Vec3:  return 3
	case .Vec4, .Dyn: return 4
	}
	return 1
}

// `expr` of type `from` as type `to`: a float spreads to every component, a
// wider vector drops its tail, a narrower one pads with zeros.
@(private = "file")
_coerce :: proc(expr: string, from, to: Port_Type) -> string {
	nf, nt := _components(from), _components(to)
	if nf == nt do return expr
	if nf == 1 do return fmt.tprintf("%s(%s)", _glsl_type(to), expr)
	if nt == 1 do return fmt.tprintf("%s.x", expr)
	if nt < nf {
		all := "xyzw"
		return fmt.tprintf("%s.%s", expr, all[:nt])
	}
	pad := strings.repeat(", 0.0", nt - nf, context.temp_allocator)
	return fmt.tprintf("%s(%s%s)", _glsl_type(to), expr, pad)
}

@(private = "file")
_literal :: proc(v: [4]f32, t: Port_Type) -> string {
	switch _components(t) {
	case 1: return fmt.tprintf("%.6f", v.x)
	case 2: return fmt.tprintf("vec2(%.6f, %.6f)", v.x, v.y)
	case 3: return fmt.tprintf("vec3(%.6f, %.6f, %.6f)", v.x, v.y, v.z)
	}
	return fmt.tprintf("vec4(%.6f, %.6f, %.6f, %.6f)", v.x, v.y, v.z, v.w)
}

// A texture node's UV: what is linked into it, the mesh's uvs when nothing is.
@(private = "file")
_texture_uv :: proc(gen: ^_Gen, id: i32, expr: string, t: Port_Type) -> string {
	if _, linked := graph_input_link(gen.g, id, 0); !linked do return "frag_uv"
	return _coerce(expr, t, .Vec2)
}
