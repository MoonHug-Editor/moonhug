		{name = "list_menus", description = "Every invokable editor menu path.", schema = "{\"type\":\"object\",\"properties\":{}}", handler = mcp_tool_list_menus},
		{name = "list_objects", description = "Objects in the active scene with their transform and components. Names repeat, so use the returned local_id to address one.", schema = "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"Only objects whose name contains this text\"}}}", handler = mcp_tool_list_objects},
		{name = "read_log", description = "Recent editor console entries, newest last.", schema = "{\"type\":\"object\",\"properties\":{\"max\":{\"type\":\"integer\",\"description\":\"How many entries to return (default 30)\"}}}", handler = mcp_tool_read_log},
		{name = "rename_object", description = "Rename one object. Address it by local_id (preferred) or exact current name. One undo step.", schema = "{\"type\":\"object\",\"properties\":{\"local_id\":{\"type\":\"integer\",\"description\":\"Object local_id from list_objects\"},\"name\":{\"type\":\"string\",\"description\":\"Exact current name (alternative to local_id)\"},\"new_name\":{\"type\":\"string\",\"description\":\"The new name\"}},\"required\":[\"new_name\"]}", handler = mcp_tool_rename_object},
		{name = "scene_dump", description = "Active scene contents: a summary (roots, transform count, selection) or the full serialized scene.", schema = "{\"type\":\"object\",\"properties\":{\"full\":{\"type\":\"boolean\",\"description\":\"Return the complete serialized scene JSON instead of the summary\"}}}", handler = mcp_tool_scene_dump},
		{name = "screenshot", description = "Capture a view's render target (previous frame). Full PNG saved to library/screenshots, downscaled copy returned inline as an image. Costs context \u2014 prefer text tools unless the question is visual.", schema = "{\"type\":\"object\",\"properties\":{\"max_size\":{\"type\":\"integer\",\"description\":\"Inline image longest edge in pixels (default 640)\"},\"view\":{\"type\":\"string\",\"description\":\"scene (default), game, or editor for the whole editor window including the inspector and other panels\"}}}", handler = mcp_tool_screenshot},
		{name = "select", description = "Select objects in the scene. Pass local_ids for an exact set (multi-selection, which is what the inspector multi-edits), or name to select every object with that name. Empty call clears the selection.", schema = "{\"type\":\"object\",\"properties\":{\"add\":{\"type\":\"boolean\",\"description\":\"Add to the current selection instead of replacing it\"},\"local_ids\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"},\"description\":\"Object local_ids from list_objects; selects exactly these, in order (last = active)\"},\"name\":{\"type\":\"string\",\"description\":\"Object name to select; selects ALL objects with this name\"}}}", handler = mcp_tool_select},
		{name = "set_transform", description = "Set a transform field on one object. Address it by local_id (preferred) or exact name. One undo step.", schema = "{\"type\":\"object\",\"properties\":{\"field\":{\"type\":\"string\",\"description\":\"position, rotation (euler degrees) or scale\"},\"local_id\":{\"type\":\"integer\",\"description\":\"Object local_id from list_objects\"},\"name\":{\"type\":\"string\",\"description\":\"Exact object name (alternative to local_id)\"},\"x\":{\"type\":\"number\",\"description\":\"X component\"},\"y\":{\"type\":\"number\",\"description\":\"Y component\"},\"z\":{\"type\":\"number\",\"description\":\"Z component\"}},\"required\":[\"field\"]}", handler = mcp_tool_set_transform},
	}
