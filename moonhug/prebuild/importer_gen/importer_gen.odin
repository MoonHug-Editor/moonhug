package importer_gen

// importer_gen: asset importers declared by attribute (docs/core/Plugins.md,
// "Asset importers").
//
//   @(importer)
//   audio_importer :: proc() -> asset_pipeline.Importer_Desc { return {...} }
//
//   generate - moonhug/registration/importers_generated.odin:
//              register_importers(), one importer_register call per
//              declaration. The editor calls it before the ImportersInit
//              phase, the tests bootstrap calls it the same way.
//
// The proc returns the description instead of a var holding it, because a
// description names procs and may call one (a version read from a template
// file), and a global initializer cannot call a proc that needs a context.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "../gen_db"
import "../gen_facts"

Importer_Entry :: struct {
	name:     string, // the declaring proc
	pkg_name: string,
	pkg_path: string,
}

Importer_GenComp :: struct {
	entry: Importer_Entry,
}

@(init)
_register :: proc "contextless" () {
	db.provider("importer/provide", provide)
	db.generator("importer/generate", generate)
}

provide :: proc(w: ^db.World) -> bool {
	importers := db.get_or_create_comps(w, Importer_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)

	m := db.all_of(db.r(decls), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		if _, has := gen_facts.attr_find(db.get(attrs, entity), "importer"); !has do continue
		p := db.get(procs, entity)
		if p == nil || !p.no_args {
			fmt.eprintf("importer: %s.%s must be a proc without parameters returning asset_pipeline.Importer_Desc\n", decl.pkg.name, decl.name)
			return false
		}
		db.set(importers, entity, Importer_GenComp{entry = {name = decl.name, pkg_name = decl.pkg.name, pkg_path = decl.pkg_path}})
	}
	return true
}

generate :: proc(w: ^db.World) -> bool {
	entries: [dynamic]Importer_Entry
	defer delete(entries)
	importers := db.get_comps(w, Importer_GenComp)
	for &c in importers.rows[:db.comps_len(importers)] do append(&entries, c.entry)
	slice.sort_by(entries[:], proc(a, b: Importer_Entry) -> bool {
		if a.pkg_name != b.pkg_name do return a.pkg_name < b.pkg_name
		return a.name < b.name
	})

	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "package registration\n\n")
	// With no importer installed the proc is empty and imports nothing.
	if len(entries) > 0 do strings.write_string(&b, "import __assets \"moonhug:editor/assets\"\n")
	last_pkg := ""
	for e in entries {
		if e.pkg_name == last_pkg do continue
		last_pkg = e.pkg_name
		fmt.sbprintf(&b, "import %s \"%s\"\n", e.pkg_name, gen_facts.pkg_import_path(e.pkg_path))
	}
	strings.write_string(&b, "\n// Code generated by importer_gen. Do not edit.\n\n")
	strings.write_string(&b, "// Every @(importer) declaration, registered with the editor's asset pipeline.\n")
	strings.write_string(&b, "register_importers :: proc() {\n")
	for e in entries {
		fmt.sbprintf(&b, "\t__assets.importer_register(%s.%s())\n", e.pkg_name, e.name)
	}
	strings.write_string(&b, "}\n")
	db.emit(w, "moonhug/registration/importers_generated.odin", strings.to_string(b))
	return true
}
