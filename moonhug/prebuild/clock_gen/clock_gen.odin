package clock_gen

// clock_gen: the Clock enum of moonhug/libs/time.
//
// - The built-in clocks come first: Update, Fixed, Unscaled.
// - A package adds clocks with a `Clock_Extra` enum of its own. Its values
//   follow the built-in ones, packages in first-seen order, duplicates once.
// - The output is clocks_generated.odin in the time package, so every
//   package names a clock as `time.Clock.<Name>`. It names no plugin and
//   compiles with no package installed.
//
//   Clock_Extra :: enum {
//       Bullet_Time,
//       Cutscene,
//   }

import "core:fmt"
import "core:strings"
import "../gen_core"
import db "../gen_db"

_OUT_FILE :: "moonhug/libs/time/clocks_generated.odin"

// In the order the enum lists them. time.odin reads these three by name.
_BUILTIN_NAMES :: []string{"Update", "Fixed", "Unscaled"}

@(init)
_register :: proc "contextless" () {
	db.generator("clock/generate", generate)
}

generate :: proc(w: ^db.World) -> bool {
	names := make([dynamic]string, context.temp_allocator)
	for n in _BUILTIN_NAMES do append(&names, n)

	seen_pkgs := make(map[string]bool, context.temp_allocator)
	decls := db.get_comps_DeclInfo()
	for &d in decls.rows[:db.comps_len(decls)] {
		if d.pkg == nil || d.name != "Clock_Extra" || seen_pkgs[d.pkg_path] do continue
		seen_pkgs[d.pkg_path] = true
		extra := gen_core.EnumFieldNames(d.decl)
		defer delete(extra)
		if len(extra) == 0 {
			fmt.eprintfln("prebuild: clock: %s.Clock_Extra must be an enum with at least one value", d.pkg.name)
			return false
		}
		for n in extra {
			already := false
			for existing in names do if existing == n do already = true
			if !already do append(&names, strings.clone(n, context.temp_allocator))
		}
	}
	if len(names) > 255 {
		fmt.eprintfln("prebuild: clock: %d clocks, the Clock enum holds 255", len(names))
		return false
	}

	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "package mh_time\n\n")
	strings.write_string(&b, "// Code generated by clock_gen. Do not edit.\n")
	strings.write_string(&b, "// The built-in clocks, then every package's Clock_Extra values (time.odin).\n\n")
	strings.write_string(&b, "Clock :: enum u8 {\n")
	for n in names do fmt.sbprintf(&b, "\t%s,\n", n)
	strings.write_string(&b, "}\n")
	db.emit(w, _OUT_FILE, strings.to_string(b))
	return true
}
