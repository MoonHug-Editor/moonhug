package asset_hook_gen

// asset_hook_gen: the procs that react to an asset changing on disk
// (moonhug/libs/assets/asset_hooks.odin).
//
//   @(asset_hook={ext="mat"})
//   asset_on_changed_material :: proc(guid: core.Asset_GUID, path: string, change: assets.Asset_Change) { ... }
//
//   The name is the contract: `asset_on_changed_<name>`, the name free. `ext`
//   filters by extension, with or without the dot, absent = every asset.
//   `order` places the hook among the hooks of one change, lower first,
//   default 0: a hook that imports declares a positive one, so every unload
//   has run before it.
//
//   generate - moonhug/registration/asset_hooks_generated.odin: every
//              declaration added from @(init), so the hooks exist before the
//              first scan, in the editor and in the tests.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "../gen_db"
import "../gen_facts"

Asset_Hook_Entry :: struct {
	name:     string,
	ext:      string,
	order:    int,
	pkg_name: string,
	pkg_path: string,
}

AssetHook_GenComp :: struct {
	entry: Asset_Hook_Entry,
}

@(init)
_register :: proc "contextless" () {
	db.provider("asset_hook/provide", provide)
	db.generator("asset_hook/generate", generate)
}

provide :: proc(w: ^db.World) -> bool {
	hooks := db.get_or_create_comps(w, AssetHook_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	m := db.all_of(db.r(decls), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		args, found := gen_facts.attr_find(db.get(attrs, entity), "asset_hook")
		if !found do continue
		if db.get(procs, entity) == nil || !strings.has_prefix(decl.name, "asset_on_changed_") || len(decl.name) == len("asset_on_changed_") {
			fmt.eprintf("asset_hook: %s.%s must be a proc named asset_on_changed_<name>\n", decl.pkg.name, decl.name)
			return false
		}
		db.set(hooks, entity, AssetHook_GenComp{entry = {name = decl.name, ext = args.fields["ext"], order = gen_facts.attr_int(args, "order"), pkg_name = decl.pkg.name, pkg_path = decl.pkg_path}})
	}
	return true
}

generate :: proc(w: ^db.World) -> bool {
	entries: [dynamic]Asset_Hook_Entry
	defer delete(entries)
	hooks := db.get_comps(w, AssetHook_GenComp)
	for &c in hooks.rows[:db.comps_len(hooks)] do append(&entries, c.entry)
	// Registration order is run order within one `order`, so the file lists
	// them by order, then by package and name for a stable file.
	slice.sort_by(entries[:], proc(a, b: Asset_Hook_Entry) -> bool {
		if a.order != b.order do return a.order < b.order
		if a.pkg_name != b.pkg_name do return a.pkg_name < b.pkg_name
		return a.name < b.name
	})

	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "package registration\n\n")
	strings.write_string(&b, "import \"base:runtime\"\n")
	// With no hook installed the proc is empty and imports nothing else.
	if len(entries) > 0 do strings.write_string(&b, "import __assets \"moonhug:libs/assets\"\n")
	imported := make(map[string]bool, context.temp_allocator)
	names := make([dynamic]string, context.temp_allocator)
	for e in entries do if e.pkg_name not_in imported {
		imported[e.pkg_name] = true
		append(&names, e.pkg_name)
	}
	slice.sort(names[:])
	for name in names {
		for e in entries do if e.pkg_name == name {
			fmt.sbprintf(&b, "import %s \"%s\"\n", name, gen_facts.pkg_import_path(e.pkg_path))
			break
		}
	}
	strings.write_string(&b, "\n// Code generated by asset_hook_gen. Do not edit.\n\n")
	strings.write_string(&b, "// Every @(asset_hook) declaration, registered before the first asset scan.\n")
	strings.write_string(&b, "@(init)\n_register_asset_hooks :: proc \"contextless\" () {\n\tcontext = runtime.default_context()\n")
	for e in entries {
		if e.order != 0 {
			fmt.sbprintf(&b, "\t__assets.asset_hook_add(%q, %s.%s, order = %d)\n", e.ext, e.pkg_name, e.name, e.order)
		} else {
			fmt.sbprintf(&b, "\t__assets.asset_hook_add(%q, %s.%s)\n", e.ext, e.pkg_name, e.name)
		}
	}
	strings.write_string(&b, "}\n")
	db.emit(w, "moonhug/registration/asset_hooks_generated.odin", strings.to_string(b))
	return true
}
