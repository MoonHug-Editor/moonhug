package serialization_gen

// serialization_gen: ECS prebuild module.
//
//   provide  - iterate the decls, recognise proc decls with a
//              @before_serialize or @after_deserialize attribute, add a
//              Serialization_GenComp (carrying kind / type_name / priority /
//              proc_name / source_pkg).
//   generate - iterate the {decls, serializations} join view, sort, build
//              serialization_generated.odin, emit it (gen_db writes it).
//
// String-building output is identical to the previous collect/generate version.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "../gen_db"
import "../gen_facts"

SerializationCallbackKind :: enum {
	BeforeSerialize,
	AfterDeserialize,
}

// Serialization_GenComp marks a DeclInfo entity as a serialization callback proc and
// carries the facts the generator needs.
Serialization_GenComp :: struct {
	kind:       SerializationCallbackKind,
	type_name:  string,
	priority:   int,
	proc_name:  string,
	source_pkg:  string,
	source_path: string, // that package's scan path, for the import
}


@(init)
_register :: proc "contextless" () {
	db.provider("serialization/provide", provide)
	db.generator("serialization/generate", generate)
}


_attr_field :: proc(attr_set: ^gen_facts.Attrs_GenComp, key: string) -> (type_name: string, priority: int, found: bool) {
	args, ok := gen_facts.attr_find(attr_set, key)
	if !ok do return "", 0, false
	type_name = args.fields["type"]
	priority = gen_facts.attr_int(args, "priority")
	return type_name, priority, type_name != ""
}

_package_from_type_name :: proc(type_name: string) -> string {
	for i in 0 ..< len(type_name) {
		if type_name[i] == '.' do return type_name[:i]
	}
	return ""
}

provide :: proc(w: ^db.World) -> bool {
	_serializations := db.get_or_create_comps(w, Serialization_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)

	m := db.all_of(db.r(decls), db.r(procs), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		attr_set := db.get(attrs, entity)

		if type_name, priority, found := _attr_field(attr_set, "before_serialize"); found {
			db.set(_serializations, entity, Serialization_GenComp{
				kind       = .BeforeSerialize,
				type_name  = type_name,
				priority   = priority,
				proc_name  = decl.name,
				source_pkg = decl.pkg.name,
				source_path = decl.pkg_path,
			})
			continue
		}
		if type_name, priority, found := _attr_field(attr_set, "after_deserialize"); found {
			db.set(_serializations, entity, Serialization_GenComp{
				kind       = .AfterDeserialize,
				type_name  = type_name,
				priority   = priority,
				proc_name  = decl.name,
				source_pkg = decl.pkg.name,
				source_path = decl.pkg_path,
			})
		}
	}
	return true
}

_OUT_DIR :: "moonhug/libs/serialization"

_SerializationRow :: struct {
	kind:        SerializationCallbackKind,
	type_name:   string,
	priority:    int,
	proc_name:   string,
	source_pkg:  string,
	source_path: string,
}

generate :: proc(w: ^db.World) -> bool {
	entries: [dynamic]_SerializationRow
	defer delete(entries)

	decls := db.get_comps_DeclInfo()
	_serializations := db.get_comps(w, Serialization_GenComp)
	m := db.all_of(db.r(decls), db.r(_serializations)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		ser := db.get(_serializations, entity)
		append(&entries, _SerializationRow{
			kind       = ser.kind,
			type_name  = ser.type_name,
			priority   = ser.priority,
			proc_name  = ser.proc_name,
			source_pkg = ser.source_pkg,
			source_path = ser.source_path,
		})
	}

	// A total order, so the files do not churn between builds.
	slice.sort_by(entries[:], proc(a, b: _SerializationRow) -> bool {
		if a.source_path != b.source_path do return a.source_path < b.source_path
		if a.kind != b.kind do return a.kind < b.kind
		if a.priority != b.priority do return a.priority < b.priority
		if a.type_name != b.type_name do return a.type_name < b.type_name
		return a.proc_name < b.proc_name
	})

	// Each package registers its own hooks at @(init), into the serialization
	// package's maps. The serialization package imports none of them: a
	// plugin imports the engine, which imports serialization, so a
	// registration written into serialization would be an import cycle.
	for start := 0; start < len(entries); {
		end := start
		for end < len(entries) && entries[end].source_path == entries[start].source_path do end += 1
		_emit_package_hooks(w, entries[start:end])
		start = end
	}

	// The serialization package's own generated file, kept so an older copy
	// on disk never outlives the move to per-package registration.
	db.emit(w, fmt.tprintf("%s/serialization_generated.odin", _OUT_DIR), "package serialization\n\n// Code generated by serialization_gen. Do not edit.\n// Hooks register from their own packages (serialization_hooks_generated.odin).\n")
	return true
}

// Writes <package>/serialization_hooks_generated.odin for the hooks one
// package declares.
@(private = "file")
_emit_package_hooks :: proc(w: ^db.World, rows: []_SerializationRow) {
	pkg_name := rows[0].source_pkg
	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	fmt.sbprintf(&b, "package %s\n\n", pkg_name)

	// Types named by another package's qualifier need that package imported.
	imports := make([dynamic]string, context.temp_allocator)
	for r in rows {
		qual := _package_from_type_name(r.type_name)
		if qual == "" || qual == pkg_name || slice.contains(imports[:], qual) do continue
		append(&imports, qual)
	}
	slice.sort(imports[:])
	strings.write_string(&b, "import \"base:runtime\"\n")
	if pkg_name != "serialization" do strings.write_string(&b, "import serialization \"moonhug:libs/serialization\"\n")
	for q in imports {
		switch q {
		case "core", "serialization", "assets", "log", "gfx":
			fmt.sbprintf(&b, "import %s \"moonhug:libs/%s\"\n", q, q)
		case:
			fmt.sbprintf(&b, "import %s \"moonhug:packages/%s\"\n", q, q)
		}
	}
	strings.write_string(&b, "\n// Code generated by serialization_gen. Do not edit.\n\n")
	strings.write_string(&b, "// This package's @(before_serialize) and @(after_deserialize) procs.\n")
	strings.write_string(&b, "@(init)\n__register_serialization_hooks :: proc \"contextless\" () {\n")
	strings.write_string(&b, "\tcontext = runtime.default_context()\n")
	qual := pkg_name == "serialization" ? "" : "serialization."
	for r in rows {
		switch r.kind {
		case .BeforeSerialize:
			fmt.sbprintf(&b, "\t%sregister_before_serialize(typeid_of(%s), %s, %d)\n", qual, r.type_name, r.proc_name, r.priority)
		case .AfterDeserialize:
			fmt.sbprintf(&b, "\t%sregister_after_deserialize(typeid_of(%s), %s, %d)\n", qual, r.type_name, r.proc_name, r.priority)
		}
	}
	strings.write_string(&b, "}\n")
	db.emit(w, fmt.tprintf("%s/serialization_hooks_generated.odin", rows[0].source_path), strings.to_string(b))
}
