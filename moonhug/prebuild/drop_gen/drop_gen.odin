package drop_gen

// drop_gen: the rules for what a drop does (moonhug/editor/drag).
//
//   @(drop={what="object", on="project"})
//   drop_objects_in_project :: proc(d: ^drag.Drop) -> bool { ... }
//
//   The name is the contract: `drop_<name>`, the name free. `what` is
//   "object", "asset" or "asset:<kind>", `on` the place: "scene",
//   "hierarchy" or "project".
//
//   generate - moonhug/registration/drops_generated.odin: every rule added
//              from @(init), so the windows find them on their first frame,
//              in the editor and in the tests. With no rule installed the
//              proc is empty and imports nothing else.

import "core:fmt"
import "core:slice"
import "core:strings"
import db "../gen_db"
import "../gen_facts"

Drop_Rule :: struct {
	name:     string,
	what:     string,
	on:       string,
	pkg_name: string,
	pkg_path: string,
}

Drop_GenComp :: struct {
	rule: Drop_Rule,
}

@(init)
_register :: proc "contextless" () {
	db.provider("drop/provide", provide)
	db.generator("drop/generate", generate)
}

provide :: proc(w: ^db.World) -> bool {
	rules := db.get_or_create_comps(w, Drop_GenComp)
	decls := db.get_comps_DeclInfo()
	procs := db.get_comps(w, gen_facts.Proc_GenComp)
	attrs := db.get_comps(w, gen_facts.Attrs_GenComp)
	m := db.all_of(db.r(decls), db.r(attrs)); defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		args, found := gen_facts.attr_find(db.get(attrs, entity), "drop")
		if !found do continue
		where_ := fmt.tprintf("%s:%d", gen_facts.decl_rel_path(decl), decl.decl.pos.line)
		if db.get(procs, entity) == nil || !strings.has_prefix(decl.name, "drop_") || len(decl.name) == len("drop_") {
			fmt.eprintf("drop: %s: %s must be a proc named drop_<name>\n", where_, decl.name)
			return false
		}
		what, on := args.fields["what"], args.fields["on"]
		if what != "object" && what != "asset" && !(strings.has_prefix(what, "asset:") && len(what) > len("asset:")) {
			fmt.eprintf("drop: %s: what=%q is \"object\", \"asset\" or \"asset:<kind>\"\n", where_, what)
			return false
		}
		if on != "scene" && on != "hierarchy" && on != "project" {
			fmt.eprintf("drop: %s: on=%q is \"scene\", \"hierarchy\" or \"project\"\n", where_, on)
			return false
		}
		if decl.pkg_path == "moonhug/editor" {
			fmt.eprintf("drop: %s: @(drop) cannot live in the editor root package, the registration would import it\n", where_)
			return false
		}
		db.set(rules, entity, Drop_GenComp{rule = {name = decl.name, what = what, on = on, pkg_name = decl.pkg.name, pkg_path = decl.pkg_path}})
	}
	return true
}

generate :: proc(w: ^db.World) -> bool {
	entries: [dynamic]Drop_Rule
	defer delete(entries)
	rules := db.get_comps(w, Drop_GenComp)
	for &c in rules.rows[:db.comps_len(rules)] do append(&entries, c.rule)
	// A stable file: by package, then name. The registry orders the rules of
	// one place itself, a kind before plain "asset".
	slice.sort_by(entries[:], proc(a, b: Drop_Rule) -> bool {
		if a.pkg_name != b.pkg_name do return a.pkg_name < b.pkg_name
		return a.name < b.name
	})

	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "package registration\n\n")
	strings.write_string(&b, "import \"base:runtime\"\n")
	if len(entries) > 0 do strings.write_string(&b, "import __drag \"moonhug:editor/drag\"\n")
	imported := make(map[string]bool, context.temp_allocator)
	names := make([dynamic]string, context.temp_allocator)
	for e in entries do if e.pkg_name not_in imported {
		imported[e.pkg_name] = true
		append(&names, e.pkg_name)
	}
	slice.sort(names[:])
	for name in names {
		for e in entries do if e.pkg_name == name {
			fmt.sbprintf(&b, "import %s \"%s\"\n", name, gen_facts.pkg_import_path(e.pkg_path))
			break
		}
	}
	strings.write_string(&b, "\n// Code generated by drop_gen. Do not edit.\n\n")
	strings.write_string(&b, "// Every @(drop) rule, registered before the first frame.\n")
	strings.write_string(&b, "@(init)\n_register_drops :: proc \"contextless\" () {\n\tcontext = runtime.default_context()\n")
	for e in entries do fmt.sbprintf(&b, "\t__drag.drop_rule_add(%q, %q, %s.%s)\n", e.what, e.on, e.pkg_name, e.name)
	strings.write_string(&b, "}\n")
	db.emit(w, "moonhug/registration/drops_generated.odin", strings.to_string(b))
	return true
}
