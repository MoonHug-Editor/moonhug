}

static inline __attribute__((always_inline))
float fog_amount(thread const float3& world_pos, constant DrawUBO& _34)
{
    int mode = int(_34.fog_color.w + 0.5);
    if (mode == 0)
    {
        return 0.0;
    }
    float3 d = world_pos - _34.view_pos.xyz;
    float dist = length(d);
    float h = 1.0;
    if (_34.fog_more.x > 0.0)
    {
        float k = _34.fog_more.x;
        float ky = k * d.y;
        float _333;
        if (abs(ky) > 9.9999997473787516355514526367188e-05)
        {
            _333 = (1.0 - exp(-ky)) / ky;
        }
        else
        {
            _333 = 1.0;
        }
        h = exp((-k) * (_34.view_pos.y - _34.fog_params.w)) * _333;
    }
    float f;
    if (mode == 1)
    {
        f = 1.0 - exp(((-_34.fog_params.x) * h) * dist);
    }
    else
    {
        if (mode == 2)
        {
            float x = (_34.fog_params.x * h) * dist;
            f = 1.0 - exp((-x) * x);
        }
        else
        {
            f = fast::clamp((dist - _34.fog_params.y) / fast::max(_34.fog_params.z - _34.fog_params.y, 9.9999997473787516355514526367188e-05), 0.0, 1.0) * fast::clamp(h, 0.0, 1.0);
        }
    }
    return fast::clamp(f, 0.0, 1.0);
}

fragment main0_out main0(main0_in in [[stage_in]], constant DrawUBO& _34 [[buffer(2)]], texture2d<float> tex [[texture(0)]], texture2d<float> ui_clip_tex [[texture(6)]], sampler texSmplr [[sampler(0)]], sampler ui_clip_texSmplr [[sampler(6)]], float4 gl_FragCoord [[position]])
{
