    float4 fog_color;
    float4 fog_params;
    float4 fog_more;
    float4 view_pos;
    float4x4 view_proj;
    float4 probe_pos;
    float4 probe_min;
    float4 probe_max;
    float4 probe2_pos;
    float4 probe2_min;
    float4 probe2_max;
