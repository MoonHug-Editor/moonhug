static inline __attribute__((always_inline))
float3 srgb_to_linear(thread const float3& c)
{
    return mix(powr((c + float3(0.054999999701976776123046875)) / float3(1.05499994754791259765625), float3(2.400000095367431640625)), c / float3(12.9200000762939453125), float3(c <= float3(0.040449999272823333740234375)));
}

static inline __attribute__((always_inline))
float ui_clip(thread const float4& t)
{
    if (t.w < 1.5)
    {
        return 1.0;
    }
    float2 d = (float2(1.0) - abs(t.xy)) / fast::max(fwidth(t.xy), float2(9.9999999747524270787835121154785e-07));
    return fast::clamp(fast::min(d.x, d.y) + 0.5, 0.0, 1.0);
}

static inline __attribute__((always_inline))
float fog_amount(thread const float3& world_pos, constant DrawUBO& _31)
{
    int mode = int(_31.fog_color.w + 0.5);
    if (mode == 0)
    {
        return 0.0;
    }
    float3 d = world_pos - _31.view_pos.xyz;
    float dist = length(d);
    float h = 1.0;
    if (_31.fog_more.x > 0.0)
    {
        float k = _31.fog_more.x;
        float ky = k * d.y;
        float _92;
        if (abs(ky) > 9.9999997473787516355514526367188e-05)
        {
            _92 = (1.0 - exp(-ky)) / ky;
        }
        else
        {
            _92 = 1.0;
        }
        h = exp((-k) * (_31.view_pos.y - _31.fog_params.w)) * _92;
    }
    float f;
    if (mode == 1)
    {
        f = 1.0 - exp(((-_31.fog_params.x) * h) * dist);
    }
    else
    {
        if (mode == 2)
        {
            float x = (_31.fog_params.x * h) * dist;
            f = 1.0 - exp((-x) * x);
        }
        else
        {
            f = fast::clamp((dist - _31.fog_params.y) / fast::max(_31.fog_params.z - _31.fog_params.y, 9.9999997473787516355514526367188e-05), 0.0, 1.0) * fast::clamp(h, 0.0, 1.0);
        }
    }
    return fast::clamp(f, 0.0, 1.0);
}

fragment main0_out main0(main0_in in [[stage_in]], constant DrawUBO& _31 [[buffer(2)]], texture2d<float> tex [[texture(0)]], sampler texSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 t = tex.sample(texSmplr, in.frag_uv);
    float3 param = t.xyz;
    out.out_color = float4(srgb_to_linear(param), t.w) * in.frag_color;
    float4 param_1 = in.frag_tangent;
    out.out_color.w *= ui_clip(param_1);
    if (out.out_color.w < _31.draw_params.x)
    {
        discard_fragment();
    }
    if (_31.draw_params.y > 0.5)
    {
        out.out_color = float4(fast::normalize(in.frag_normal), 1.0);
        return out;
    }
    float4 _270 = out.out_color;
    float3 param_2 = in.frag_world_pos;
    float3 _280 = mix(_270.xyz, _31.fog_color.xyz, float3(fog_amount(param_2, _31)));
    out.out_color.x = _280.x;
    out.out_color.y = _280.y;
    out.out_color.z = _280.z;
    return out;
}

