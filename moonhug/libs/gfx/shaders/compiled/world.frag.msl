static inline __attribute__((always_inline))
float3 srgb_to_linear(thread const float3& c)
{
    return mix(powr((c + float3(0.054999999701976776123046875)) / float3(1.05499994754791259765625), float3(2.400000095367431640625)), c / float3(12.9200000762939453125), float3(c <= float3(0.040449999272823333740234375)));
}

static inline __attribute__((always_inline))
float ui_clip_at(thread const float2& frag, constant DrawUBO& _34, texture2d<float> ui_clip_tex, sampler ui_clip_texSmplr)
{
    int count = int(_34.clip_count.x + 0.5);
    int textured = int(_34.clip_count.y + 0.5) - 1;
    float2 tex_uv = float2(0.0);
    float a = 1.0;
    float _141;
    float _147;
    float _160;
    float _207;
    for (int i = 0; (i < count) && (i < 8); i++)
    {
        int b = i * 5;
        float3 h = float3(dot(_34.clip_masks[b].xyz, float3(frag, 1.0)), dot(_34.clip_masks[b + 1].xyz, float3(frag, 1.0)), dot(_34.clip_masks[b + 2].xyz, float3(frag, 1.0)));
        float2 p = h.xy / float2(h.z);
        float2 half_size = _34.clip_masks[b + 3].xy;
        float soft = _34.clip_masks[b + 3].z;
        float4 radii = _34.clip_masks[b + 4];
        if (p.x > 0.0)
        {
            if (p.y > 0.0)
            {
                _147 = radii.y;
            }
            else
            {
                _147 = radii.z;
            }
            _141 = _147;
        }
        else
        {
            if (p.y > 0.0)
            {
                _160 = radii.x;
            }
            else
            {
                _160 = radii.w;
            }
            _141 = _160;
        }
        float r = _141;
        r = fast::min(r, fast::min(half_size.x, half_size.y));
        float2 q = (abs(p) - half_size) + float2(r);
        float d = (fast::min(fast::max(q.x, q.y), 0.0) + length(fast::max(q, float2(0.0)))) - r;
        float px = fast::max(fwidth(d), 9.9999999747524270787835121154785e-07);
        if (soft > 0.0)
        {
            _207 = fast::clamp((-d) / fast::max(soft, px), 0.0, 1.0);
        }
        else
        {
            _207 = fast::clamp(0.5 - (d / px), 0.0, 1.0);
        }
        a *= _207;
        if (i == textured)
        {
            float2 unit = float2((p.x / (2.0 * half_size.x)) + 0.5, 0.5 - (p.y / (2.0 * half_size.y)));
            tex_uv = float2(_34.clip_masks[b].w, _34.clip_masks[b + 1].w) + (unit * float2(_34.clip_masks[b + 2].w, _34.clip_masks[b + 3].w));
        }
    }
    if (textured >= 0)
