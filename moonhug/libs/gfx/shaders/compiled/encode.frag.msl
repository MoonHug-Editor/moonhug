#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 out_color [[color(0)]];
};

struct main0_in
{
    float2 frag_uv [[user(locn0)]];
};

static inline __attribute__((always_inline))
float3 linear_to_srgb(thread float3& c)
{
    c = fast::max(c, float3(0.0));
    float3 lo = c * 12.9200000762939453125;
    float3 hi = (powr(c, float3(0.4166666567325592041015625)) * 1.05499994754791259765625) - float3(0.054999999701976776123046875);
    return mix(hi, lo, float3(c <= float3(0.003130800090730190277099609375)));
}

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> tex [[texture(0)]], sampler texSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 c = tex.sample(texSmplr, in.frag_uv);
    float3 param = c.xyz;
    float3 _63 = linear_to_srgb(param);
    out.out_color = float4(_63, c.w);
    return out;
}

