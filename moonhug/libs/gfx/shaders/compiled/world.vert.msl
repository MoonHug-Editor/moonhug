static inline __attribute__((always_inline))
float3 srgb_to_linear(thread float3& c)
{
    float m = fast::max(fast::max(c.x, c.y), fast::max(c.z, 1.0));
    c /= float3(m);
    return mix(powr((c + float3(0.054999999701976776123046875)) / float3(1.05499994754791259765625), float3(2.400000095367431640625)), c / float3(12.9200000762939453125), float3(c <= float3(0.040449999272823333740234375))) * m;
}

vertex main0_out main0(main0_in in [[stage_in]], constant UBO& _115 [[buffer(0)]])
{
    main0_out out = {};
    float4x4 model = float4x4(float4(in.in_model0), float4(in.in_model1), float4(in.in_model2), float4(in.in_model3));
    float4 world = model * float4(in.in_position, 1.0);
    float4 _120 = _115.view_proj * world;
    out.gl_Position = _120;
    float _133 = out.gl_Position.w - out.gl_Position.z;
    float _134 = _115.vert_params.x * _133;
    float _137 = out.gl_Position.z - _134;
    out.gl_Position.z = _137;
    out.frag_uv = in.in_uv;
    out.frag_uv2 = in.in_uv2;
    float3 param = in.in_color.xyz;
    float3 _153 = srgb_to_linear(param);
    float3 param_1 = in.in_tint.xyz;
    float3 _158 = srgb_to_linear(param_1);
    out.frag_color = float4(_153 * _158, in.in_color.w * in.in_tint.w);
    out.frag_normal = float3x3(model[0].xyz, model[1].xyz, model[2].xyz) * in.in_normal;
    out.frag_world_pos = world.xyz;
    float mirror = (determinant(float3x3(model[0].xyz, model[1].xyz, model[2].xyz)) < 0.0) ? (-1.0) : 1.0;
    out.frag_tangent = float4(float3x3(model[0].xyz, model[1].xyz, model[2].xyz) * in.in_tangent.xyz, in.in_tangent.w * mirror);
    return out;
}

