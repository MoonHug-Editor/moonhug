#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct DrawUBO
{
    float4 draw_params;
    float4 fog_color;
    float4 fog_params;
    float4 fog_more;
    float4 view_pos;
    float4x4 view_proj;
    float4 probe_pos;
    float4 probe_min;
    float4 probe_max;
    float4 probe2_pos;
    float4 probe2_min;
    float4 probe2_max;
    float4 probe_blend;
    uint4 draw_layers;
};

struct main0_out
{
    float4 out_color [[color(0)]];
};

struct main0_in
{
    float2 frag_uv [[user(locn0)]];
    float3 frag_normal [[user(locn2)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant DrawUBO& _25 [[buffer(2)]], texture2d<float> tex [[texture(0)]], sampler texSmplr [[sampler(0)]])
{
    main0_out out = {};
    if (tex.sample(texSmplr, in.frag_uv).w < _25.draw_params.x)
    {
        discard_fragment();
    }
    float3 n = fast::normalize(in.frag_normal);
    out.out_color = float4((n * 0.5) + float3(0.5), 1.0);
    return out;
}

