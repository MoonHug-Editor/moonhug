    }
    else
    {
        _213 = _206;
    }
    bool _220;
    if (!_213)
    {
        _220 = ndc.z > 1.0;
    }
    else
    {
        _220 = _213;
    }
    if (_220)
    {
        return 1.0;
    }
    float depth = ndc.z - _149.shadow_params.y;
    float texel = _149.shadow_params.x;
    float lit = 0.0;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            float d = shadow_map.sample(shadow_mapSmplr, (uv + (float2(float(x), float(y)) * texel))).x;
            lit += float(depth <= d);
