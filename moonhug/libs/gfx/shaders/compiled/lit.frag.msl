    float4 lp = _149.shadow_vp * float4(world_pos, 1.0);
    float3 ndc = lp.xyz / float3(lp.w);
    float2 uv = float2((ndc.x * 0.5) + 0.5, 1.0 - ((ndc.y * 0.5) + 0.5));
    bool _192 = uv.x < 0.0;
    bool _199;
    if (!_192)
    {
        _199 = uv.x > 1.0;
    }
    else
    {
        _199 = _192;
    }
    bool _206;
    if (!_199)
    {
        _206 = uv.y < 0.0;
    }
