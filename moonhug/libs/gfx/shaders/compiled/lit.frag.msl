fragment main0_out main0(main0_in in [[stage_in]], constant LightUBO& _104 [[buffer(0)]], texture2d<float> tex [[texture(0)]], texture2d<float> shadow_map [[texture(7)]], sampler texSmplr [[sampler(0)]], sampler shadow_mapSmplr [[sampler(7)]])
