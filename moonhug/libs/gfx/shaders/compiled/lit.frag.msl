    float3 light = float3(ambient);
    GpuLight l;
    float3 L;
    for (int i = 0; i < count; i++)
    {
        l.pos_type = _149.lights[i].pos_type;
        l.dir_range = _149.lights[i].dir_range;
        l.color_outer = _149.lights[i].color_outer;
