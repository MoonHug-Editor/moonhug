package sequencer_gen

// tween_gen: emits TweenUnion, the evaluate dispatch, and tween_base.
//
// A clip-tween variant is a struct embedding `base: Clip_Tween` with an
// evaluate_<Name>(self, t, ctx) proc — pose as a pure function of
// clip-normalized time — and an optional destroy_<Name>. Same discovery
// rules as script_gen: syntax-only base matching, procs in the variant's own
// file.
//
// tween_base is generated too: it hands back the embedded Clip_Tween of the
// active variant, which is how the track clears captures generically.

import "core:fmt"
import "core:slice"
import "core:strings"
import "moonhug:prebuild/gen_core"
import db "moonhug:prebuild/gen_db"
import "moonhug:prebuild/gen_facts"

Tween_GenComp :: struct {
	has_evaluate: bool,
	has_destroy:  bool,
}

@(init)
_register_tween :: proc "contextless" () {
	db.provider("sequencer/tween/provide", tween_provide)
	db.generator("sequencer/tween/generate", tween_generate)
}

tween_provide :: proc(w: ^db.World) -> bool {
	decls := db.get_comps_DeclInfo()
	structs := db.get_comps(w, gen_facts.Struct_GenComp)
	field_comps := db.get_comps(w, gen_facts.Fields_GenComp)
	tweens := db.get_or_create_comps(w, Tween_GenComp)

	m := db.all_of(db.r(decls), db.r(structs), db.r(field_comps))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		if decl.name == "" do continue
		fields := db.get(field_comps, entity)
		if !_has_base(fields.fields, "Clip_Tween") do continue

		eval_name := strings.concatenate({"evaluate_", decl.name}, context.temp_allocator)
		destroy_name := strings.concatenate({"destroy_", decl.name}, context.temp_allocator)
		db.set(tweens, entity, Tween_GenComp{
			has_evaluate = gen_core.FileHasProc(decl.file, eval_name),
			has_destroy  = gen_core.FileHasProc(decl.file, destroy_name),
		})
	}
	return true
}

_Tween_Row :: struct {
	type_name: string,
	pkg_name:  string,
	pkg_path:  string,
	using gen: Tween_GenComp,
}

tween_generate :: proc(w: ^db.World) -> bool {
	rows: [dynamic]_Tween_Row
	defer delete(rows)

	decls := db.get_comps_DeclInfo()
	tweens := db.get_comps(w, Tween_GenComp)
	m := db.all_of(db.r(decls), db.r(tweens))
	defer db.matcher_destroy(&m)
	for entity in db.matched(w, &m) {
		decl := db.get(decls, entity)
		append(&rows, _Tween_Row{
			type_name = decl.name,
			pkg_name  = decl.pkg.name,
			pkg_path  = decl.pkg_path,
			gen       = db.get(tweens, entity)^,
		})
	}
	slice.sort_by(rows[:], proc(a, b: _Tween_Row) -> bool {
		if a.type_name != b.type_name do return a.type_name < b.type_name
		return a.pkg_path < b.pkg_path
	})

	b := strings.builder_make()
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "package sequencer\n\n")
	strings.write_string(&b, "import \"core:encoding/json\"\n")
	strings.write_string(&b, "import \"moonhug:engine\"\n")
	strings.write_string(&b, "import serialization \"moonhug:engine/serialization\"\n")
	strings.write_string(&b, "import core \"moonhug:packages/sequencer/core\"\n")
	{
		imported: [dynamic]string
		defer delete(imported)
		for e in rows {
			found := false
			for p in imported do if p == e.pkg_path { found = true; break }
			if found do continue
			append(&imported, e.pkg_path)
			fmt.sbprintf(&b, "import %s \"moonhug:%s\"\n", e.pkg_name, e.pkg_path[len("moonhug/"):])
		}
	}
	strings.write_string(&b, "\n// Code generated by tween_gen. Do not edit.\n")
	strings.write_string(&b, "// A clip-tween variant is a struct embedding core.Clip_Tween with an\n")
	strings.write_string(&b, "// evaluate_<Name> proc (and destroy_<Name> when it owns heap). Ship one in\n")
	strings.write_string(&b, "// a package importing moonhug:packages/sequencer/core and it joins the\n")
	strings.write_string(&b, "// union on the next prebuild.\n\n")

	strings.write_string(&b, "TweenUnion :: union {\n")
	for e in rows do fmt.sbprintf(&b, "\t%s.%s,\n", e.pkg_name, e.type_name)
	strings.write_string(&b, "}\n\n")

	strings.write_string(&b, "// Poses the active variant at clip-normalized t in [0..1].\n")
	strings.write_string(&b, "tween_evaluate :: proc(u: ^TweenUnion, t: f32, ctx: ^core.Tween_Ctx) {\n")
	strings.write_string(&b, "\tswitch &v in u {\n")
	for e in rows {
		fmt.sbprintf(&b, "\tcase %s.%s:\n", e.pkg_name, e.type_name)
		if e.has_evaluate {
			fmt.sbprintf(&b, "\t\t%s.evaluate_%s(&v, t, ctx)\n", e.pkg_name, e.type_name)
		} else {
			strings.write_string(&b, "\t\t// no evaluate proc\n")
		}
	}
	strings.write_string(&b, "\t}\n}\n\n")

	strings.write_string(&b, "// The embedded Clip_Tween base of the active variant, nil for a nil union —\n")
	strings.write_string(&b, "// what lets the track test and clear `captured` without per-variant code.\n")
	strings.write_string(&b, "tween_base :: proc(u: ^TweenUnion) -> ^core.Clip_Tween {\n")
	strings.write_string(&b, "\tswitch &v in u {\n")
	for e in rows {
		fmt.sbprintf(&b, "\tcase %s.%s:\n", e.pkg_name, e.type_name)
		strings.write_string(&b, "\t\treturn &v.base\n")
	}
	strings.write_string(&b, "\t}\n\treturn nil\n}\n\n")

	strings.write_string(&b, "// Frees whatever heap the active variant owns and clears the union.\n")
	strings.write_string(&b, "tween_destroy :: proc(u: ^TweenUnion) {\n")
	if _any_tween(rows[:], proc(e: _Tween_Row) -> bool { return e.has_destroy }) {
		strings.write_string(&b, "\tswitch &v in u {\n")
		for e in rows {
			fmt.sbprintf(&b, "\tcase %s.%s:\n", e.pkg_name, e.type_name)
			if e.has_destroy {
				fmt.sbprintf(&b, "\t\t%s.destroy_%s(&v)\n", e.pkg_name, e.type_name)
			} else {
				strings.write_string(&b, "\t\t// no heap\n")
			}
		}
		strings.write_string(&b, "\t}\n")
	}
	strings.write_string(&b, "\tu^ = nil\n")
	strings.write_string(&b, "}\n\n")

	strings.write_string(&b, "@(phase={key=SerializationInit, order=2})\n")
	strings.write_string(&b, "tween_union_serialization_init :: proc() {\n")
	strings.write_string(&b, "\t@(static) done := false\n")
	strings.write_string(&b, "\tif done do return\n")
	strings.write_string(&b, "\tdone = true\n")
	strings.write_string(&b, "\tjson.register_user_marshaler(TweenUnion, serialization.union_marshal)\n")
	strings.write_string(&b, "\tjson.register_user_unmarshaler(TweenUnion, serialization.union_unmarshal)\n")
	strings.write_string(&b, "\tengine.register_pointer_type(TweenUnion)\n")
	strings.write_string(&b, "}\n")

	db.emit(w, "moonhug/packages/sequencer/tween_union_generated.odin", strings.to_string(b))
	return true
}

@(private = "file")
_any_tween :: proc(rows: []_Tween_Row, pred: proc(e: _Tween_Row) -> bool) -> bool {
	for e in rows do if pred(e) do return true
	return false
}
