                },
                {
                    "description": "Non-interactive sessions: avoid debuginfod y/n prompt",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "GDB in IDE: no ---Type <return> to continue---",
                    "text": "set pagination off",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug tests (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "build-tests-debug-linux",
            "program": "${workspaceFolder}/builds/MoonHug_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Non-interactive sessions: avoid debuginfod y/n prompt",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "GDB in IDE: no ---Type <return> to continue---",
                    "text": "set pagination off",
                    "ignoreFailures": true
                }
            ]
        }
    ]
